<%- include('../partials/header') %>

<main class="min-h-screen bg-slate-950 py-6 px-4 sm:px-6 lg:px-8">
    <div class="space-y-6 max-w-7xl mx-auto pb-6">

        <div>
            <a href="/" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-400 hover:text-white transition">
                <i class="fa-solid fa-arrow-left"></i> Volver al inicio
            </a>
        </div>

        <!-- ======================================================= -->
        <!-- MÓDULO DESTACADO: AVISO IMPORTANTE DINÁMICO POR COLOR   -->
        <!-- ======================================================= -->
        <% 
            const numAvisos = typeof avisos !== 'undefined' ? avisos.length : 0; 
            const aviso = numAvisos > 0 ? avisos[0] : null;

            // Configuración de temas según la prioridad del aviso
            let tema = {
                border: 'border-amber-400/80',
                glow: 'shadow-[0_0_25px_rgba(245,158,11,0.25)]',
                gradient: 'from-amber-500/20',
                badgeBg: 'bg-amber-500',
                iconContainer: 'bg-amber-500/30 text-amber-300 border-amber-400/50',
                tagBg: 'bg-amber-500/30 text-amber-300 border-amber-500/50',
                tagText: 'Normal',
                btnBg: 'bg-amber-500 hover:bg-amber-400 shadow-amber-500/20',
                dateColor: 'text-amber-300/80',
                kpiBorder: 'border-amber-400 shadow-amber-500/20',
                kpiText: 'text-amber-400'
            };

            if (aviso) {
                if (aviso.prioridad === 'Alta') {
                    tema = {
                        border: 'border-rose-500/80',
                        glow: 'shadow-[0_0_25px_rgba(244,63,94,0.3)]',
                        gradient: 'from-rose-500/20',
                        badgeBg: 'bg-rose-500',
                        iconContainer: 'bg-rose-500/30 text-rose-300 border-rose-500/50',
                        tagBg: 'bg-rose-500/30 text-rose-300 border-rose-500/50',
                        tagText: 'Urgente',
                        btnBg: 'bg-rose-500 hover:bg-rose-400 shadow-rose-500/20',
                        dateColor: 'text-rose-300/80',
                        kpiBorder: 'border-rose-500 shadow-rose-500/20',
                        kpiText: 'text-rose-400'
                    };
                } else if (aviso.prioridad === 'Baja') {
                    tema = {
                        border: 'border-emerald-500/80',
                        glow: 'shadow-[0_0_25px_rgba(16,185,129,0.25)]',
                        gradient: 'from-emerald-500/20',
                        badgeBg: 'bg-emerald-500',
                        iconContainer: 'bg-emerald-500/30 text-emerald-300 border-emerald-500/50',
                        tagBg: 'bg-emerald-500/30 text-emerald-300 border-emerald-500/50',
                        tagText: 'Baja',
                        btnBg: 'bg-emerald-500 hover:bg-emerald-400 shadow-emerald-500/20',
                        dateColor: 'text-emerald-300/80',
                        kpiBorder: 'border-emerald-400 shadow-emerald-500/20',
                        kpiText: 'text-emerald-400'
                    };
                }
            }
        %>
        
        <% if (numAvisos > 0) { %>
            <!-- Inicia oculto por defecto para evitar parpadeos -->
            <div id="bannerAvisoPrincipal" data-id="<%= aviso.id_aviso %>" style="display: none;"
                 class="relative bg-gradient-to-r <%= tema.gradient %> via-slate-900 to-slate-900 border-2 <%= tema.border %> rounded-2xl p-5 <%= tema.glow %> flex-col md:flex-row items-start md:items-center justify-between gap-5 transition-all">
                
                <!-- Badge superior flotante -->
                <div class="absolute -top-3 left-6 px-3 py-0.5 rounded-full <%= tema.badgeBg %> text-slate-950 text-[10px] font-black uppercase tracking-widest shadow-md flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-slate-950 animate-ping"></span>
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    Comunicado Oficial Importante
                </div>

                <div class="flex items-start gap-4 pt-1 md:pt-0">
                    <div class="w-12 h-12 rounded-2xl <%= tema.iconContainer %> flex items-center justify-center text-2xl shrink-0 shadow-inner mt-1">
                        <i class="fa-solid fa-bullhorn animate-bounce"></i>
                    </div>
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <h2 class="text-base font-extrabold text-white tracking-wide"><%= aviso.titulo %></h2>
                            <span class="px-2 py-0.5 text-[9px] font-extrabold <%= tema.tagBg %> rounded-md uppercase tracking-wider">
                                <%= tema.tagText %>
                            </span>
                        </div>
                        <p class="text-xs text-slate-200 leading-relaxed bg-slate-950/60 p-3 rounded-xl border border-slate-800/80 max-w-4xl shadow-inner">
                            <%= aviso.contenido %>
                        </p>
                        <p class="text-[10px] <%= tema.dateColor %> font-medium">
                            Publicado por <span class="text-white font-semibold"><%= aviso.autor_nombre %> <%= aviso.autor_apellido %></span> • <%= new Date(aviso.fecha_publicacion).toLocaleDateString('es-CL') %>
                        </p>
                    </div>
                </div>

                <!-- Botón Ver Historial -->
                <div class="shrink-0 w-full md:w-auto flex md:flex-col items-center justify-end gap-2 pt-2 md:pt-0 border-t md:border-t-0 border-slate-700/50">
                    <a href="/profesor/avisos" class="w-full md:w-auto px-5 py-2.5 <%= tema.btnBg %> text-slate-950 font-extrabold rounded-xl text-xs transition-all flex items-center justify-center gap-2 shadow-lg cursor-pointer">
                        <i class="fa-solid fa-layer-group"></i>
                        <span>Ver Historial (<%= numAvisos %>)</span>
                    </a>
                </div>
            </div>

            <!-- Evaluación síncrona inmediata antes del pintado del DOM -->
            <script>
                (function() {
                    const banner = document.getElementById('bannerAvisoPrincipal');
                    if (banner) {
                        const idAviso = parseInt(banner.getAttribute('data-id'), 10);
                        const vistosProfesor = JSON.parse(localStorage.getItem('avisos_vistos_profesor') || '[]');
                        if (!vistosProfesor.includes(idAviso)) {
                            banner.style.display = 'flex';
                        }
                    }
                })();
            </script>
        <% } %>

        <!-- 1. CABECERA PRINCIPAL Y KPIS -->
        <div class="bg-slate-900/90 p-6 rounded-2xl shadow-xl border border-slate-800 flex flex-col md:flex-row items-center justify-between gap-6 relative">
            <div class="flex items-center gap-4 z-10">
                <div class="w-14 h-14 rounded-2xl bg-teal-500/20 text-teal-400 border border-teal-500/30 flex items-center justify-center text-2xl shrink-0 shadow-inner">
                    <i class="fa-solid fa-chalkboard-user"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <h1 class="text-2xl font-bold text-white tracking-tight">Panel del Profesor Diferencial</h1>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-teal-500/20 text-teal-300 border border-teal-500/40 uppercase tracking-wider">
                            PIE / NEE
                        </span>
                    </div>
                    <p class="text-xs text-slate-400">
                        Docente: <span class="text-slate-200 font-semibold"><%= user ? (user.nombre + ' ' + user.apellido) : 'Docente' %></span>
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 w-full md:w-auto z-10">
                <div class="bg-slate-950/80 p-3 rounded-xl border border-slate-800 text-center min-w-[105px]">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">ESTUDIANTES</p>
                    <p class="text-xl font-extrabold text-teal-400"><%= typeof estudiantes !== 'undefined' ? estudiantes.length : 0 %></p>
                </div>
                
                <div class="bg-slate-950/80 p-3 rounded-xl border border-slate-800 text-center min-w-[105px]">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">FUDEI PEND.</p>
                    <p class="text-xl font-extrabold text-amber-400"><%= typeof fudeiPendientes !== 'undefined' ? fudeiPendientes : 0 %></p>
                </div>

                <!-- TARJETA KPI DE AVISOS CON COLOR ADAPTATIVO -->
                <a href="/profesor/avisos" class="bg-slate-950/80 p-3 rounded-xl border <%= numAvisos > 0 ? tema.kpiBorder : 'border-slate-800' %> text-center min-w-[105px] flex flex-col items-center justify-center cursor-pointer hover:bg-slate-800 transition">
                    <div class="flex items-center gap-1 mb-0.5">
                        <p class="text-[10px] font-bold <%= numAvisos > 0 ? tema.kpiText : 'text-slate-400' %> uppercase tracking-wider">AVISOS</p>
                        <% if (numAvisos > 0) { %>
                            <span class="w-2 h-2 rounded-full <%= tema.badgeBg %> animate-ping"></span>
                        <% } %>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <i class="fa-solid fa-bell <%= tema.kpiText %> text-sm"></i>
                        <span class="text-xl font-extrabold text-white"><%= numAvisos %></span>
                    </div>
                </a>

                <% const pendientesChat = typeof mensajesPendientes !== 'undefined' ? mensajesPendientes : 0; %>
                <a href="/profesor/atencionApo" id="tarjetaChat" class="bg-slate-950/80 p-3 rounded-xl border <%= pendientesChat > 0 ? 'border-sky-500/60' : 'border-slate-800' %> text-center min-w-[105px] flex flex-col items-center justify-center cursor-pointer hover:bg-slate-800 transition">
                    <div class="flex items-center gap-1 mb-1">
                        <p class="text-[10px] font-bold <%= pendientesChat > 0 ? 'text-sky-300' : 'text-slate-400' %> uppercase tracking-wider" data-chat-titulo>CHAT DOCENTE</p>
                        <span data-chat-ping class="w-2 h-2 rounded-full bg-sky-400 animate-ping <%= pendientesChat > 0 ? '' : 'hidden' %>"></span>
                    </div>
                    <p class="text-xl font-extrabold text-sky-400 <%= pendientesChat > 0 ? 'hidden' : '' %>" data-chat-activo>Activo</p>
                    <p class="text-sm font-extrabold text-white leading-tight <%= pendientesChat > 0 ? '' : 'hidden' %>" data-chat-pendientes>
                        <i class="fa-solid fa-envelope text-sky-400 mr-1"></i><span data-chat-total><%= pendientesChat %></span> <span class="text-[10px] font-bold text-sky-300 uppercase">pendiente(s)</span>
                    </p>
                </a>
            </div>
        </div>

        <!-- 2. GRID PRINCIPAL (8 COLS IZQ / 4 COLS DER) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- SECCIÓN IZQUIERDA: ALUMNOS ASIGNADOS -->
            <div class="lg:col-span-8 bg-slate-900/90 rounded-2xl p-6 border border-slate-800 shadow-xl flex flex-col justify-between space-y-4">
                <div>
                    <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
                        <div>
                            <h2 class="text-lg font-bold text-white flex items-center gap-2">
                                <i class="fa-solid fa-users text-teal-400"></i>
                                Alumnos Asignados & Expedientes FUDEI
                            </h2>
                            <p class="text-xs text-slate-400">Nómina oficial de estudiantes PIE registrados bajo su tutela pedagógica.</p>
                        </div>
                        <a href="/profesor/estudiantes" class="text-xs text-teal-400 hover:text-teal-300 font-semibold flex items-center gap-1 transition">
                            <span>Ver todos</span>
                            <i class="fa-solid fa-arrow-right text-[10px]"></i>
                        </a>
                    </div>

                    <div class="space-y-2.5 max-h-[350px] overflow-y-auto pr-1">
                        <% if (typeof estudiantes !== 'undefined' && estudiantes.length > 0) { %>
                            <% estudiantes.forEach(est => { %>
                                <div class="p-3.5 rounded-xl border border-slate-800 bg-slate-950/60 hover:bg-slate-950 transition flex items-center justify-between gap-4">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <div class="w-9 h-9 rounded-full bg-slate-800 border border-slate-700 text-teal-400 font-bold text-xs flex items-center justify-center shrink-0">
                                            <%= est.nombre.charAt(0) %><%= est.apellido.charAt(0) %>
                                        </div>
                                        <div class="min-w-0">
                                            <p class="text-xs font-bold text-white truncate"><%= est.nombre %> <%= est.apellido %></p>
                                            <p class="text-[11px] text-slate-400 truncate">RUT: <%= est.rut %> • <%= est.nombre_curso || 'Curso Sin Asignar' %></p>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-3 shrink-0">
                                        <% if (est.tipo_nee) { %>
                                            <span class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[10px] font-bold bg-indigo-500/10 text-indigo-300 border border-indigo-500/30">
                                                <i class="fa-solid fa-brain text-[9px]"></i>
                                                <%= est.tipo_nee %>
                                            </span>
                                        <% } %>

                                        <a href="/profesor/informe-notas/<%= est.id_estudiante %>" class="p-2 bg-sky-600/20 hover:bg-sky-600 text-sky-300 hover:text-white rounded-lg text-xs transition border border-sky-500/30" title="Descargar informe de notas">
                                            <i class="fa-solid fa-file-arrow-down"></i>
                                        </a>

                                        <a href="/profesor/fudei/<%= est.id_estudiante %>" class="p-2 bg-teal-600/20 hover:bg-teal-600 text-teal-300 hover:text-white rounded-lg text-xs transition border border-teal-500/30" title="Editar FUDEI">
                                            <i class="fa-solid fa-file-signature"></i>
                                        </a>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="text-center py-16 bg-slate-950/40 rounded-xl border border-dashed border-slate-800 space-y-3">
                                <i class="fa-solid fa-folder-open text-4xl text-slate-600"></i>
                                <p class="text-xs text-slate-400">No hay estudiantes PIE asignados actualmente a tu cuenta.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="pt-2">
                    <a href="/profesor/estudiantes" class="w-full py-2.5 bg-teal-600 hover:bg-teal-500 text-white font-semibold rounded-xl text-xs transition flex items-center justify-center gap-2 shadow-md">
                        <i class="fa-solid fa-folder-open text-xs"></i>
                        <span>Administración Completa de Expedientes</span>
                    </a>
                </div>
            </div>

            <!-- SECCIÓN DERECHA: TARJETAS SECUNDARIAS Y ACCIONES -->
            <div class="lg:col-span-4 space-y-6">

                <!-- TARJETA DESTACADA: CONTROL DE ASISTENCIA DIARIA -->
                <div class="bg-slate-900/90 p-5 rounded-2xl border border-teal-500/40 shadow-xl space-y-3 relative overflow-hidden">
                    <div class="absolute -right-3 -top-3 w-16 h-16 bg-teal-500/10 rounded-full blur-xl pointer-events-none"></div>
                    <div class="flex items-center gap-2.5">
                        <div class="w-9 h-9 rounded-xl bg-teal-500/20 text-teal-400 flex items-center justify-center text-sm border border-teal-500/30 shrink-0">
                            <i class="fa-solid fa-clipboard-user"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-bold text-white">Control de Asistencia</h3>
                            <p class="text-[10px] text-teal-400 font-extrabold uppercase tracking-wider">Acción Diaria</p>
                        </div>
                    </div>
                    <p class="text-[11px] text-slate-400 leading-relaxed">
                        Registra la presencia, ausencias e imprevistos de tus estudiantes en tiempo real.
                    </p>
                    <a href="/profesor/asistencia" class="w-full py-2.5 bg-teal-600 hover:bg-teal-500 text-white font-semibold rounded-xl text-xs transition flex items-center justify-center gap-2 shadow-md">
                        <i class="fa-solid fa-check-double text-xs"></i>
                        <span>Tomar Asistencia Hoy</span>
                    </a>
                </div>

                <!-- TARJETA SOLICITUDES DE INGRESO -->
                <div class="bg-slate-900/90 p-5 rounded-2xl border border-slate-800 shadow-xl space-y-3">
                    <div class="flex items-center gap-2.5">
                        <div class="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-sm border border-amber-500/30">
                            <i class="fa-solid fa-user-clock"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-bold text-white">Solicitudes de Ingreso</h3>
                            <p class="text-[10px] text-amber-400 font-semibold uppercase tracking-wider">Matrículas Pendientes</p>
                        </div>
                    </div>
                    <p class="text-[11px] text-slate-400 leading-relaxed">
                        Revisa las solicitudes de nuevos pupilos registrados por los apoderados para tus cursos y aprueba su ingreso.
                    </p>
                    <a href="/profesor/solicitudes" class="w-full py-2.5 bg-amber-600 hover:bg-amber-500 text-white font-semibold rounded-xl text-xs transition flex items-center justify-center gap-2 shadow-md">
                        <i class="fa-solid fa-id-card text-xs"></i>
                        <span>Revisar Solicitudes</span>
                    </a>
                </div>

                <!-- TARJETA REGISTRO ACADÉMICO -->
                <div class="bg-slate-900/90 p-5 rounded-2xl border border-slate-800 shadow-xl space-y-3">
                    <div class="flex items-center gap-2.5">
                        <div class="w-9 h-9 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-sm border border-amber-500/30">
                            <i class="fa-solid fa-graduation-cap"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-bold text-white">Registro Académico</h3>
                            <p class="text-[10px] text-slate-400">Evaluación Diferenciada</p>
                        </div>
                    </div>
                    <p class="text-[11px] text-slate-400 leading-relaxed">
                        Ingresa notas por asignatura y observaciones del progreso curricular de tus pupilos.
                    </p>
                    <a href="/profesor/calificaciones" class="w-full py-2.5 bg-slate-800 hover:bg-slate-700 text-amber-300 hover:text-amber-200 font-semibold rounded-xl text-xs border border-slate-700 transition flex items-center justify-center gap-2 shadow-sm">
                        <i class="fa-solid fa-pen-to-square text-xs"></i>
                        <span>Ingresar Calificaciones</span>
                    </a>
                </div>

                <!-- TARJETA ATENCIÓN A APODERADOS -->
                <div class="bg-slate-900/90 p-5 rounded-2xl border border-slate-800 shadow-xl space-y-3">
                    <div class="flex items-center gap-2.5">
                        <div class="w-9 h-9 rounded-xl bg-sky-500/20 text-sky-400 flex items-center justify-center text-sm border border-sky-500/30">
                            <i class="fa-solid fa-comments"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-bold text-white">Atención a Apoderados</h3>
                            <p class="text-[10px] text-slate-400">Comunicación Directa</p>
                        </div>
                    </div>
                    <p class="text-[11px] text-slate-400 leading-relaxed">
                        Mantén contacto con los apoderados de tus alumnos para coordinar informes y apoyos.
                    </p>
                    <a href="/profesor/mensajes" class="w-full py-2.5 bg-teal-600 hover:bg-teal-500 text-white font-semibold rounded-xl text-xs transition flex items-center justify-center gap-2 shadow-md">
                        <i class="fa-solid fa-paper-plane text-xs"></i>
                        <span>Abrir Chat Docente</span>
                    </a>
                </div>

            </div>

        </div>
    </div>
</main>

<script src="/js/pendientes.js"></script>

<%- include('../partials/footer') %>