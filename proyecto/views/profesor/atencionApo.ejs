<%- include('../partials/header') %>

<div class="space-y-4 max-w-7xl mx-auto pb-6">

    <!-- ENCABEZADO CON BOTÓN DE VUELTA Y BOTÓN DE AVISO MASIVO POR CURSO -->
    <div class="bg-slate-800/90 p-4 sm:p-5 rounded-2xl shadow-xl border border-slate-700/70 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4 w-full md:w-auto">
            <a href="/profesor" class="p-2.5 rounded-xl bg-slate-700/60 hover:bg-slate-700 text-slate-300 hover:text-white transition border border-slate-600/60 shrink-0" title="Volver al Panel Docente">
                <i class="fa-solid fa-arrow-left text-sm"></i>
            </a>
            <div>
                <h1 class="text-lg sm:text-xl font-bold text-white tracking-tight flex items-center gap-2">
                    <i class="fa-solid fa-comments text-sky-400"></i>
                    Atención a Apoderados & Mensajería
                </h1>
                <p class="text-xs text-slate-400">Mensajes directos con los apoderados de tus cursos y avisos por curso</p>
            </div>
        </div>

        <button type="button" id="btnAbrirModalAviso" class="w-full md:w-auto px-5 py-2.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-extrabold rounded-xl text-xs transition-all flex items-center justify-center gap-2 shadow-lg shadow-amber-500/20 cursor-pointer shrink-0">
            <i class="fa-solid fa-bullhorn text-sm"></i>
            <span>Aviso para Todos / Por Curso</span>
        </button>
    </div>

    <!-- INTERFAZ DE CHAT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 lg:gap-4 bg-slate-800/90 rounded-2xl border border-slate-700/70 shadow-2xl overflow-hidden h-[620px]">

        <!-- LISTA DE APODERADOS -->
        <div class="lg:col-span-4 bg-slate-900/80 border-r border-slate-700/70 flex flex-col h-full min-h-0">

            <div class="p-3.5 border-b border-slate-700/70 bg-slate-900">
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-500 text-xs"></i>
                    <input type="text" id="inputBuscarContacto" placeholder="Buscar apoderado, alumno o curso..."
                           class="w-full bg-slate-800/90 text-slate-200 text-xs pl-8 pr-3 py-2 rounded-xl border border-slate-700 focus:outline-none focus:border-sky-400 placeholder-slate-500">
                </div>
            </div>

            <div class="divide-y divide-slate-800 overflow-y-auto flex-1" id="listaContactos">
                <% if (apoderados.length > 0) { %>
                    <% apoderados.forEach((apo) => { %>
                        <div data-id-usuario="<%= apo.id_usuario_apoderado %>"
                             data-nombre-completo="<%= apo.apo_nombre %> <%= apo.apo_apellido %>"
                             data-iniciales="<%= apo.apo_nombre.charAt(0) %><%= apo.apo_apellido.charAt(0) %>"
                             data-hijos="<%= apo.hijos || '' %>"
                             data-cursos="<%= apo.cursos || '' %>"
                             data-busqueda="<%= (apo.apo_nombre + ' ' + apo.apo_apellido + ' ' + (apo.hijos || '') + ' ' + (apo.cursos || '')).toLowerCase() %>"
                             class="item-contacto p-3.5 hover:bg-slate-800/80 cursor-pointer transition flex items-center justify-between gap-3">

                            <div class="flex items-center gap-3 min-w-0">
                                <div class="w-10 h-10 rounded-full bg-sky-500/20 text-sky-300 border border-sky-500/40 font-bold text-xs flex items-center justify-center shrink-0 shadow-inner">
                                    <%= apo.apo_nombre.charAt(0) %><%= apo.apo_apellido.charAt(0) %>
                                </div>

                                <div class="min-w-0">
                                    <h3 class="text-xs font-bold text-white truncate"><%= apo.apo_nombre %> <%= apo.apo_apellido %></h3>
                                    <p class="text-[11px] text-slate-400 truncate">
                                        Pupilo: <span class="text-slate-300 font-medium"><%= apo.hijos %></span>
                                    </p>
                                    <p data-ultimo class="text-[10px] text-slate-500 truncate">Sin mensajes</p>
                                </div>
                            </div>

                            <div class="text-right shrink-0 flex flex-col items-end gap-1">
                                <span data-hora class="text-[9px] text-slate-500"></span>
                                <span data-insignia class="hidden min-w-[16px] h-4 px-1 rounded-full bg-sky-500 text-slate-950 font-black text-[9px] flex items-center justify-center shadow"></span>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="p-8 text-center text-slate-500 space-y-2">
                        <i class="fa-solid fa-comments text-3xl text-slate-600 block"></i>
                        <p class="text-xs">No hay apoderados vinculados a tus cursos.</p>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- CONVERSACIÓN -->
        <div class="lg:col-span-8 bg-slate-950/50 flex flex-col h-full min-h-0 relative">

            <% if (apoderados.length > 0) { %>

                <div class="p-3.5 bg-slate-900/90 border-b border-slate-700/70 flex items-center justify-between shrink-0 shadow-md">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full bg-sky-500/20 text-sky-300 font-bold text-xs border border-sky-500/40 flex items-center justify-center shrink-0" id="chatAvatar"></div>
                        <div class="min-w-0">
                            <h2 class="text-xs font-bold text-white" id="chatNombreApoderado"></h2>
                            <p class="text-[10px] text-slate-400 truncate" id="chatDetallePupilo"></p>
                        </div>
                    </div>
                    <span class="px-2.5 py-1 text-[10px] font-bold bg-sky-500/10 text-sky-300 border border-sky-500/30 rounded-full flex items-center gap-1.5">
                        <i class="fa-solid fa-lock text-[9px]"></i>
                        Conversación privada
                    </span>
                </div>

                <div class="p-4 overflow-y-auto flex-1 min-h-0 space-y-3" id="contenedorMensajes" style="background-image: radial-gradient(rgba(255,255,255,0.03) 1px, transparent 0); background-size: 16px 16px;"></div>

                <div class="p-3 bg-slate-900/90 border-t border-slate-700/70 shrink-0">
                    <form id="formEnviarChat" class="flex items-center gap-2" autocomplete="off">
                        <input type="text" id="inputMensajeTexto" placeholder="Escribe un mensaje aquí..." maxlength="1000" required
                               class="w-full bg-slate-800 text-white text-xs px-4 py-2.5 rounded-xl border border-slate-700 focus:outline-none focus:border-sky-400 placeholder-slate-500">

                        <button type="submit" class="px-4 py-2.5 bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold rounded-xl text-xs transition flex items-center justify-center gap-1.5 shadow-md shrink-0 disabled:opacity-60">
                            <span>Enviar</span>
                            <i class="fa-solid fa-paper-plane text-xs"></i>
                        </button>
                    </form>
                </div>

            <% } else { %>
                <div class="h-full flex flex-col items-center justify-center text-center p-12 text-slate-500 space-y-3">
                    <i class="fa-solid fa-comments text-4xl text-slate-600"></i>
                    <p class="text-xs">Cuando tengas apoderados vinculados a tus cursos podrás conversar con ellos aquí.</p>
                </div>
            <% } %>

        </div>

    </div>

    <!-- HISTORIAL DE COMUNICADOS -->
    <div class="bg-slate-800/90 rounded-2xl border border-slate-700/70 shadow-xl overflow-hidden">
        <div class="p-4 sm:px-6 border-b border-slate-700/70 flex items-center justify-between gap-3 flex-wrap">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-amber-500/10 text-amber-400 border border-amber-500/30 flex items-center justify-center">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
                <div>
                    <h2 class="text-sm font-bold text-white">Historial de comunicados</h2>
                    <p class="text-[11px] text-slate-400">Avisos que has enviado a los cursos. Puedes editarlos o eliminarlos.</p>
                </div>
            </div>
            <span class="text-[11px] font-bold px-3 py-1 rounded-full bg-slate-900 text-slate-300 border border-slate-700"><%= comunicados.length %> enviado(s)</span>
        </div>

        <% if (comunicados.length === 0) { %>
            <div class="p-8 text-center text-slate-400 text-xs space-y-2">
                <i class="fa-regular fa-paper-plane text-2xl text-slate-600"></i>
                <p>Aún no has enviado comunicados.</p>
            </div>
        <% } else { %>
            <ul class="divide-y divide-slate-700/60" id="listaComunicados">
                <% comunicados.forEach((aviso) => { %>
                    <% const clasePrioridad = aviso.prioridad === 'Alta' ? 'bg-rose-500/20 text-rose-300 border-rose-500/40' : (aviso.prioridad === 'Baja' ? 'bg-slate-700 text-slate-300 border-slate-600' : 'bg-sky-500/20 text-sky-300 border-sky-500/40'); %>
                    <li class="p-4 sm:px-6 flex flex-col md:flex-row md:items-start justify-between gap-3 hover:bg-slate-700/20 transition">
                        <div class="min-w-0 space-y-1.5">
                            <div class="flex items-center flex-wrap gap-2">
                                <h3 class="text-sm font-bold text-white break-words"><%= aviso.titulo %></h3>
                                <span class="px-2 py-0.5 rounded-md text-[10px] font-bold border <%= clasePrioridad %>"><%= aviso.prioridad %></span>
                            </div>
                            <p class="text-xs text-slate-300 whitespace-pre-wrap break-words line-clamp-3"><%= aviso.contenido %></p>
                            <p class="text-[11px] text-slate-400 flex flex-wrap items-center gap-x-3 gap-y-1">
                                <span><i class="fa-solid fa-users text-amber-400 mr-1"></i><%= aviso.cursos %></span>
                                <span><i class="fa-regular fa-calendar text-slate-500 mr-1"></i><%= new Date(aviso.fecha_publicacion).toLocaleString('es-CL', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/Santiago' }) %></span>
                            </p>
                        </div>

                        <div class="flex items-center gap-2 shrink-0">
                            <button type="button"
                                    class="btn-editar-comunicado px-3 py-1.5 bg-amber-500/20 hover:bg-amber-500 text-amber-300 hover:text-slate-950 rounded-lg text-[11px] font-semibold transition border border-amber-500/30 flex items-center gap-1.5"
                                    data-id="<%= aviso.id_aviso %>"
                                    data-titulo="<%= aviso.titulo %>"
                                    data-contenido="<%= aviso.contenido %>"
                                    data-prioridad="<%= aviso.prioridad %>"
                                    data-cursos="<%= aviso.ids_cursos %>">
                                <i class="fa-solid fa-pen-to-square"></i><span>Editar</span>
                            </button>
                            <button type="button"
                                    class="btn-eliminar-comunicado px-3 py-1.5 bg-rose-500/20 hover:bg-rose-500 text-rose-300 hover:text-white rounded-lg text-[11px] font-semibold transition border border-rose-500/30 flex items-center gap-1.5"
                                    data-id="<%= aviso.id_aviso %>"
                                    data-titulo="<%= aviso.titulo %>">
                                <i class="fa-solid fa-trash-can"></i><span>Eliminar</span>
                            </button>
                        </div>
                    </li>
                <% }) %>
            </ul>
        <% } %>
    </div>
</div>

<form id="formEliminarComunicado" method="POST" class="hidden"></form>

<!-- MODAL DE EDICIÓN DE COMUNICADO -->
<div id="modalEditarComunicado" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-800 border border-slate-700/80 w-full max-w-xl rounded-2xl p-6 shadow-2xl space-y-4 relative max-h-[92vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-3 border-b border-slate-700">
            <h3 class="text-base font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-pen-to-square text-amber-400"></i>
                Editar comunicado
            </h3>
            <button type="button" id="btnCerrarEditar" class="text-slate-400 hover:text-white transition text-sm">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form method="POST" id="formEditarComunicado" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Cursos destinatarios</label>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2" id="editarCursos">
                    <% cursos.forEach((c) => { %>
                        <label class="flex items-center gap-2 bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-slate-200 cursor-pointer">
                            <input type="checkbox" name="id_curso" value="<%= c.id_curso %>" class="accent-amber-500">
                            <span><%= c.nombre_curso %></span>
                        </label>
                    <% }) %>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Prioridad</label>
                    <select name="prioridad" id="editarPrioridad" class="w-full bg-slate-900 text-white text-xs px-3.5 py-2.5 rounded-xl border border-slate-700 focus:outline-none focus:border-amber-400">
                        <option value="Normal">Normal</option>
                        <option value="Alta">Alta / Urgente</option>
                        <option value="Baja">Baja</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Título</label>
                    <input type="text" name="titulo" id="editarTitulo" required maxlength="100"
                           class="w-full bg-slate-900 text-white text-xs px-3.5 py-2.5 rounded-xl border border-slate-700 focus:outline-none focus:border-amber-400">
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Cuerpo del comunicado</label>
                <textarea name="contenido" id="editarContenido" rows="5" required maxlength="2000"
                          class="w-full bg-slate-900 text-white text-xs p-3.5 rounded-xl border border-slate-700 focus:outline-none focus:border-amber-400"></textarea>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" id="btnCancelarEditar" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-300 font-semibold text-xs rounded-xl transition">Cancelar</button>
                <button type="submit" class="px-5 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs rounded-xl transition shadow-md flex items-center gap-1.5">
                    <i class="fa-solid fa-floppy-disk"></i>
                    <span>Guardar cambios</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL DE AVISO PARA TODOS / FILTRADO POR CURSO -->
<div id="modalAvisoMasivo" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-800 border border-slate-700/80 w-full max-w-xl rounded-2xl p-6 shadow-2xl space-y-4 relative">

        <div class="flex items-center justify-between pb-3 border-b border-slate-700">
            <h3 class="text-base font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-bullhorn text-amber-400"></i>
                Publicar Comunicado o Aviso por Curso
            </h3>
            <button type="button" id="btnCerrarModalAviso" class="text-slate-400 hover:text-white transition text-sm">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form action="/profesor/enviar-aviso-masivo" method="POST" class="space-y-4" id="formAvisoMasivo">

            <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Destinatarios / Curso</label>
                <select name="id_curso" class="w-full bg-slate-900 text-white text-xs px-3.5 py-2.5 rounded-xl border border-slate-700 focus:outline-none focus:border-amber-400">
                    <option value="TODOS">Todos mis cursos asignados</option>
                    <% cursos.forEach((c) => { %>
                        <option value="<%= c.id_curso %>"><%= c.nombre_curso %></option>
                    <% }) %>
                </select>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Prioridad</label>
                    <select name="prioridad" class="w-full bg-slate-900 text-white text-xs px-3.5 py-2.5 rounded-xl border border-slate-700 focus:outline-none focus:border-amber-400">
                        <option value="Normal">Normal</option>
                        <option value="Alta">Alta / Urgente</option>
                        <option value="Baja">Baja</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">Título del Mensaje</label>
                    <input type="text" name="titulo" required maxlength="100" placeholder="Ej: Materiales para taller"
                           class="w-full bg-slate-900 text-white text-xs px-3.5 py-2.5 rounded-xl border border-slate-700 focus:outline-none focus:border-amber-400">
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Cuerpo del Comunicado</label>
                <textarea name="contenido" rows="4" required maxlength="2000" placeholder="Escriba aquí el aviso para los apoderados seleccionados..."
                          class="w-full bg-slate-900 text-white text-xs p-3.5 rounded-xl border border-slate-700 focus:outline-none focus:border-amber-400"></textarea>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button" id="btnCancelarModalAviso" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-slate-300 font-semibold text-xs rounded-xl transition">
                    Cancelar
                </button>
                <button type="submit" class="px-5 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs rounded-xl transition shadow-md flex items-center gap-1.5">
                    <i class="fa-solid fa-paper-plane"></i>
                    <span>Emitir Comunicado</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script src="/js/chat.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        Educare.mostrarMensajes(<%- JSON.stringify({ success: success, error: error }).replace(/</g, '\\u003c') %>);

        const inputBuscar = document.getElementById('inputBuscarContacto');
        if (inputBuscar) {
            inputBuscar.addEventListener('input', () => {
                const q = inputBuscar.value.toLowerCase().trim();
                document.querySelectorAll('.item-contacto').forEach((el) => {
                    el.style.display = (el.getAttribute('data-busqueda') || '').includes(q) ? 'flex' : 'none';
                });
            });
        }

        if (window.ChatCliente) {
            ChatCliente.iniciar({
                contenedorId: 'contenedorMensajes',
                formId: 'formEnviarChat',
                inputId: 'inputMensajeTexto',
                itemSelector: '.item-contacto',
                claseActiva: ['bg-slate-800/90', 'border-l-4', 'border-sky-400'],
                indiceInicial: <%= indiceInicial %>,
                alSeleccionar: (item) => {
                    document.getElementById('chatNombreApoderado').textContent = item.getAttribute('data-nombre-completo');
                    document.getElementById('chatAvatar').textContent = item.getAttribute('data-iniciales');
                    document.getElementById('chatDetallePupilo').textContent =
                        'Apoderado de: ' + item.getAttribute('data-hijos') + ' (' + item.getAttribute('data-cursos') + ')';
                }
            });
        }

        const modalEditar = document.getElementById('modalEditarComunicado');
        const formEditar = document.getElementById('formEditarComunicado');
        const cerrarEditar = () => modalEditar.classList.add('hidden');
        document.getElementById('btnCerrarEditar').addEventListener('click', cerrarEditar);
        document.getElementById('btnCancelarEditar').addEventListener('click', cerrarEditar);
        modalEditar.addEventListener('click', (e) => { if (e.target === modalEditar) cerrarEditar(); });

        document.querySelectorAll('.btn-editar-comunicado').forEach((boton) => boton.addEventListener('click', () => {
            const cursosAviso = (boton.getAttribute('data-cursos') || '').split(',').filter(Boolean);
            formEditar.action = '/profesor/comunicados/' + boton.getAttribute('data-id') + '/editar';
            document.getElementById('editarTitulo').value = boton.getAttribute('data-titulo');
            document.getElementById('editarContenido').value = boton.getAttribute('data-contenido');
            document.getElementById('editarPrioridad').value = boton.getAttribute('data-prioridad');
            document.querySelectorAll('#editarCursos input[type="checkbox"]').forEach((check) => {
                check.checked = cursosAviso.includes(check.value);
            });
            modalEditar.classList.remove('hidden');
        }));

        formEditar.addEventListener('submit', (e) => {
            if (!formEditar.querySelector('#editarCursos input:checked')) {
                e.preventDefault();
                Educare.notificar('warning', 'Falta un destinatario', 'Selecciona al menos un curso.');
            }
        });

        document.querySelectorAll('.btn-eliminar-comunicado').forEach((boton) => boton.addEventListener('click', async () => {
            const resultado = await Educare.confirmar({
                title: '¿Eliminar comunicado?',
                text: 'Se eliminará "' + boton.getAttribute('data-titulo') + '" y dejará de verse para los apoderados. Esta acción no se puede deshacer.',
                confirmButtonText: 'Sí, eliminar'
            });
            if (!resultado.isConfirmed) return;
            const form = document.getElementById('formEliminarComunicado');
            form.action = '/profesor/comunicados/' + boton.getAttribute('data-id') + '/eliminar';
            form.submit();
        }));

        const modal = document.getElementById('modalAvisoMasivo');
        const btnAbrir = document.getElementById('btnAbrirModalAviso');
        if (modal && btnAbrir) {
            const cerrar = () => modal.classList.add('hidden');
            btnAbrir.addEventListener('click', () => modal.classList.remove('hidden'));
            document.getElementById('btnCerrarModalAviso').addEventListener('click', cerrar);
            document.getElementById('btnCancelarModalAviso').addEventListener('click', cerrar);
            modal.addEventListener('click', (e) => { if (e.target === modal) cerrar(); });
        }
    });
</script>

<%- include('../partials/footer') %>
