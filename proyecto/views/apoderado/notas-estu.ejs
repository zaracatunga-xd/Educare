<%- include('../partials/header') %>

<main class="min-h-screen bg-slate-950 py-6 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto space-y-5">

        <div class="flex items-center justify-between bg-slate-900/50 backdrop-blur-md border border-slate-800/80 p-4 sm:px-6 rounded-2xl shadow-lg">
            <a href="/apoderado" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-300 hover:text-teal-300 bg-slate-800/80 hover:bg-slate-800 border border-slate-700/50 px-4 py-2.5 rounded-xl shadow-sm transition-all duration-200">
                <i class="fa-solid fa-arrow-left text-xs"></i>
                <span>Volver al panel principal</span>
            </a>
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider hidden sm:inline-block">Boletín del Estudiante</span>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="p-4 rounded-2xl bg-rose-950/40 border border-rose-800/60 text-rose-300 text-xs flex items-center gap-3 shadow-md">
                <i class="fa-solid fa-circle-exclamation text-base text-rose-400"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <% if (pupilos && pupilos.length > 0) { %>
            <div class="bg-slate-900/60 backdrop-blur-lg border border-slate-800/80 p-4 rounded-2xl shadow-xl flex flex-wrap items-center gap-3">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider pl-1 flex items-center gap-2">
                    <i class="fa-solid fa-users text-teal-400 text-xs"></i>
                    Pupilo:
                </span>
                <div class="flex flex-wrap gap-2">
                    <% pupilos.forEach(p => { %>
                        <% const esActivo = (pupiloSeleccionado && pupiloSeleccionado.id_estudiante === p.id_estudiante); %>
                        <a href="/apoderado/notas-estu/<%= p.id_estudiante %>"
                           class="px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 flex items-center gap-2 border <%= esActivo ? 'bg-gradient-to-r from-teal-500 to-emerald-600 text-slate-950 border-teal-400 shadow-md shadow-teal-500/20' : 'bg-slate-800/60 text-slate-300 border-slate-700/60 hover:bg-slate-800 hover:text-white' %>">
                            <i class="fa-solid fa-user-graduate"></i>
                            <span><%= p.nombre %> <%= p.apellido %></span>
                        </a>
                    <% }) %>
                </div>
            </div>
        <% } %>

        <% if (pupiloSeleccionado) { %>
            <div class="bg-slate-900/60 backdrop-blur-lg border border-slate-800/80 p-5 sm:p-6 rounded-2xl shadow-xl space-y-4">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-teal-500/10 text-teal-400 border border-teal-500/30 flex items-center justify-center text-xl shrink-0 shadow-inner">
                            <i class="fa-solid fa-graduation-cap"></i>
                        </div>
                        <div>
                            <h1 class="text-lg font-bold text-slate-100"><%= pupiloSeleccionado.nombre %> <%= pupiloSeleccionado.apellido %></h1>
                            <p class="text-xs text-slate-400 mt-0.5">RUT: <%= pupiloSeleccionado.rut %><% if (periodoSeleccionado) { %> &bull; Curso: <span class="text-slate-200 font-semibold"><%= periodoSeleccionado.nombre_curso || 'Sin asignar' %></span><% } %></p>
                        </div>
                    </div>

                    <% if (periodoSeleccionado) { %>
                        <a href="/apoderado/notas-estu/<%= pupiloSeleccionado.id_estudiante %>/informe?periodo=<%= periodoSeleccionado.id_curso_periodo %>"
                           class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-teal-500 to-emerald-600 hover:from-teal-400 hover:to-emerald-500 text-slate-950 font-extrabold text-xs px-5 py-2.5 rounded-xl shadow-lg shadow-teal-900/30 transition">
                            <i class="fa-solid fa-file-arrow-down"></i>
                            <span>Descargar informe PDF</span>
                        </a>
                    <% } %>
                </div>

                <% if (periodos.length > 1) { %>
                    <div class="flex flex-wrap items-center gap-2 pt-3 border-t border-slate-800/80">
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Periodo:</span>
                        <% periodos.forEach(per => { %>
                            <% const activoPer = periodoSeleccionado && periodoSeleccionado.id_curso_periodo === per.id_curso_periodo; %>
                            <a href="/apoderado/notas-estu/<%= pupiloSeleccionado.id_estudiante %>?periodo=<%= per.id_curso_periodo %>"
                               class="px-3 py-1.5 rounded-lg text-[11px] font-bold border transition <%= activoPer ? 'bg-teal-500/20 text-teal-300 border-teal-500/40' : 'bg-slate-800/60 text-slate-300 border-slate-700/60 hover:bg-slate-800' %>">
                                <%= per.etiqueta %>
                            </a>
                        <% }) %>
                    </div>
                <% } %>
            </div>

            <% if (!periodoSeleccionado) { %>
                <div class="py-12 text-center text-slate-400 bg-slate-900/60 rounded-2xl border border-dashed border-slate-800">
                    <i class="fa-solid fa-folder-open text-3xl mb-2 block text-slate-600"></i>
                    <span class="text-sm">El estudiante aún no tiene una inscripción aprobada, por lo que no hay calificaciones disponibles.</span>
                </div>
            <% } else if (boletin) { %>
                <% const colorProm = (n) => n === null ? 'text-slate-500' : (n >= 4 ? 'text-teal-400' : 'text-rose-400'); %>

                <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
                    <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4 text-center shadow-lg">
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Promedio general</p>
                        <p class="text-3xl font-black <%= colorProm(boletin.promedioGeneral) %>"><%= formatoNota(boletin.promedioGeneral) %></p>
                    </div>
                    <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4 text-center shadow-lg">
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Aprobadas</p>
                        <p class="text-3xl font-black text-emerald-400"><%= boletin.resumen.aprobadas %><span class="text-sm text-slate-500 font-bold"> / <%= boletin.resumen.asignaturas %></span></p>
                    </div>
                    <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4 text-center shadow-lg">
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">En riesgo</p>
                        <p class="text-3xl font-black <%= boletin.resumen.reprobadas > 0 ? 'text-rose-400' : 'text-slate-500' %>"><%= boletin.resumen.reprobadas %></p>
                    </div>
                    <div class="bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4 text-center shadow-lg">
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Notas registradas</p>
                        <p class="text-3xl font-black text-sky-400"><%= boletin.resumen.notas %></p>
                    </div>
                </div>

                <% if (boletin.asignaturas.length > 0) { %>
                    <div class="flex flex-wrap items-center gap-2" id="filtrosNotas">
                        <% [['todas','Todas'],['APROBADO','Aprobadas'],['REPROBADO','En riesgo'],['PENDIENTE','Sin notas']].forEach(([valor, texto], i) => { %>
                            <button type="button" data-filtro="<%= valor %>"
                                    class="filtro-notas px-3.5 py-1.5 rounded-lg text-[11px] font-bold border transition <%= i === 0 ? 'bg-teal-500/20 text-teal-300 border-teal-500/40' : 'bg-slate-800/60 text-slate-300 border-slate-700/60 hover:bg-slate-800' %>">
                                <%= texto %>
                            </button>
                        <% }) %>
                    </div>

                    <div class="space-y-3" id="listaAsignaturas">
                        <% boletin.asignaturas.forEach(asig => { %>
                            <details open data-estado="<%= asig.estado %>" class="asignatura-card bg-slate-900/60 border border-slate-800/80 rounded-2xl shadow-xl overflow-hidden">
                                <summary class="cursor-pointer list-none p-4 sm:px-6 flex flex-wrap items-center justify-between gap-3">
                                    <div class="min-w-0">
                                        <h2 class="text-sm font-bold text-slate-100 truncate"><%= asig.nombre %></h2>
                                        <p class="text-[11px] text-slate-400 truncate"><i class="fa-solid fa-chalkboard-user text-teal-400 mr-1"></i><%= asig.profesor %> &bull; <%= asig.calificadas %> de <%= asig.total %> evaluaciones &bull; <%= asig.cobertura %>% evaluado</p>
                                    </div>
                                    <div class="flex items-center gap-3 shrink-0">
                                        <span class="text-xl font-black <%= colorProm(asig.promedio) %>"><%= formatoNota(asig.promedio) %></span>
                                        <% if (asig.estado === 'APROBADO') { %>
                                            <span class="px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-wider bg-emerald-950/60 text-emerald-300 border border-emerald-700/50">Aprobado</span>
                                        <% } else if (asig.estado === 'REPROBADO') { %>
                                            <span class="px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-wider bg-rose-950/60 text-rose-300 border border-rose-700/50">En riesgo</span>
                                        <% } else { %>
                                            <span class="px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-wider bg-slate-800/80 text-slate-400 border border-slate-700/60">Sin notas</span>
                                        <% } %>
                                        <i class="fa-solid fa-chevron-down text-slate-500 text-xs"></i>
                                    </div>
                                </summary>

                                <div class="px-4 sm:px-6 pb-4 border-t border-slate-800/70">
                                    <% if (asig.evaluaciones.length === 0) { %>
                                        <p class="py-4 text-xs text-slate-500">Aún no hay evaluaciones registradas en esta asignatura.</p>
                                    <% } else { %>
                                        <div class="overflow-x-auto">
                                            <table class="w-full text-left text-xs mt-2">
                                                <thead>
                                                    <tr class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                                                        <th class="py-2 pr-3">Evaluación</th>
                                                        <th class="py-2 px-3">Tipo</th>
                                                        <th class="py-2 px-3">Fecha</th>
                                                        <th class="py-2 px-3 text-center">Pond.</th>
                                                        <th class="py-2 px-3 text-center">Puntaje</th>
                                                        <th class="py-2 pl-3 text-center">Nota</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="divide-y divide-slate-800/60">
                                                    <% asig.evaluaciones.forEach(ev => { %>
                                                        <tr>
                                                            <td class="py-2.5 pr-3 font-semibold text-slate-100"><%= ev.nombre %></td>
                                                            <td class="py-2.5 px-3 text-slate-300"><%= ev.tipo %></td>
                                                            <td class="py-2.5 px-3 text-slate-300 whitespace-nowrap"><%= formatoFecha(ev.fecha) %></td>
                                                            <td class="py-2.5 px-3 text-center text-slate-300"><%= ev.porcentaje %>%</td>
                                                            <td class="py-2.5 px-3 text-center text-slate-300"><%= ev.puntaje === null ? '-' : ev.puntaje + ' / ' + ev.puntajeMaximo %></td>
                                                            <td class="py-2.5 pl-3 text-center font-black text-sm <%= colorProm(ev.nota) %>"><%= formatoNota(ev.nota) %></td>
                                                        </tr>
                                                    <% }) %>
                                                </tbody>
                                            </table>
                                        </div>
                                    <% } %>
                                    <% if (asig.observacion) { %>
                                        <p class="mt-3 text-[11px] text-slate-300 bg-slate-950/60 border border-slate-800 rounded-xl px-3 py-2">
                                            <i class="fa-solid fa-comment-dots text-sky-400 mr-1"></i>
                                            <span class="font-bold text-slate-200">Observación del docente:</span> <%= asig.observacion %>
                                        </p>
                                    <% } %>
                                </div>
                            </details>
                        <% }) %>
                    </div>

                    <p id="sinResultadosNotas" class="hidden py-8 text-center text-xs text-slate-400 bg-slate-900/60 rounded-2xl border border-dashed border-slate-800">No hay asignaturas en esta categoría.</p>
                    <p class="text-[11px] text-slate-500 text-center">El promedio de cada asignatura pondera las evaluaciones calificadas según su porcentaje. Nota mínima de aprobación: 4,0.</p>
                <% } else { %>
                    <div class="py-12 text-center text-slate-400 bg-slate-900/60 rounded-2xl border border-dashed border-slate-800">
                        <i class="fa-solid fa-book-open text-3xl mb-2 block text-slate-600"></i>
                        <span class="text-sm">Aún no hay asignaturas registradas para este curso y periodo.</span>
                    </div>
                <% } %>
            <% } %>
        <% } %>

    </div>
</main>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const botones = document.querySelectorAll('.filtro-notas');
        const tarjetas = document.querySelectorAll('.asignatura-card');
        const vacio = document.getElementById('sinResultadosNotas');
        const activo = ['bg-teal-500/20', 'text-teal-300', 'border-teal-500/40'];
        const inactivo = ['bg-slate-800/60', 'text-slate-300', 'border-slate-700/60', 'hover:bg-slate-800'];

        botones.forEach((boton) => boton.addEventListener('click', () => {
            const filtro = boton.getAttribute('data-filtro');
            botones.forEach((b) => {
                b.classList.remove(...activo, ...inactivo);
                b.classList.add(...(b === boton ? activo : inactivo));
            });
            let visibles = 0;
            tarjetas.forEach((t) => {
                const mostrar = filtro === 'todas' || t.getAttribute('data-estado') === filtro;
                t.classList.toggle('hidden', !mostrar);
                if (mostrar) visibles += 1;
            });
            if (vacio) vacio.classList.toggle('hidden', visibles > 0);
        }));
    });
</script>

<%- include('../partials/footer') %>
