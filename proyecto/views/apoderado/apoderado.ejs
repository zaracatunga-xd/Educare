<%- include('../partials/header') %>

<main class="min-h-screen bg-slate-950 py-6 px-4 sm:px-6 lg:px-8">
    <div class="space-y-6 max-w-7xl mx-auto pb-6">

        <div>
            <a href="/" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-400 hover:text-white transition">
                <i class="fa-solid fa-arrow-left"></i> Volver al inicio
            </a>
        </div>

        <!-- ======================================================= -->
        <!-- MÓDULO DESTACADO: AVISO IMPORTANTE DINÁMICO POR COLOR   -->
        <!-- ======================================================= -->
        <% 
            const numAvisos = typeof avisos !== 'undefined' ? avisos.length : 0; 
            const aviso = numAvisos > 0 ? avisos[0] : null;

            let tema = {
                border: 'border-amber-400/80',
                glow: 'shadow-[0_0_25px_rgba(245,158,11,0.25)]',
                gradient: 'from-amber-500/20',
                badgeBg: 'bg-amber-500',
                iconContainer: 'bg-amber-500/30 text-amber-300 border-amber-400/50',
                tagBg: 'bg-amber-500/30 text-amber-300 border-amber-500/50',
                tagText: 'Normal',
                btnBg: 'bg-amber-500 hover:bg-amber-400 shadow-amber-500/20',
                dateColor: 'text-amber-300/80',
                kpiBorder: 'border-amber-400 shadow-amber-500/20',
                kpiText: 'text-amber-400'
            };

            if (aviso) {
                if (aviso.prioridad === 'Alta') {
                    tema = {
                        border: 'border-rose-500/80',
                        glow: 'shadow-[0_0_25px_rgba(244,63,94,0.3)]',
                        gradient: 'from-rose-500/20',
                        badgeBg: 'bg-rose-500',
                        iconContainer: 'bg-rose-500/30 text-rose-300 border-rose-500/50',
                        tagBg: 'bg-rose-500/30 text-rose-300 border-rose-500/50',
                        tagText: 'Urgente',
                        btnBg: 'bg-rose-500 hover:bg-rose-400 shadow-rose-500/20',
                        dateColor: 'text-rose-300/80',
                        kpiBorder: 'border-rose-500 shadow-rose-500/20',
                        kpiText: 'text-rose-400'
                    };
                } else if (aviso.prioridad === 'Baja') {
                    tema = {
                        border: 'border-emerald-500/80',
                        glow: 'shadow-[0_0_25px_rgba(16,185,129,0.25)]',
                        gradient: 'from-emerald-500/20',
                        badgeBg: 'bg-emerald-500',
                        iconContainer: 'bg-emerald-500/30 text-emerald-300 border-emerald-500/50',
                        tagBg: 'bg-emerald-500/30 text-emerald-300 border-emerald-500/50',
                        tagText: 'Baja',
                        btnBg: 'bg-emerald-500 hover:bg-emerald-400 shadow-emerald-500/20',
                        dateColor: 'text-emerald-300/80',
                        kpiBorder: 'border-emerald-400 shadow-emerald-500/20',
                        kpiText: 'text-emerald-400'
                    };
                }
            }
        %>
        
        <% if (numAvisos > 0) { %>
            <!-- Inicia oculto por defecto para evitar parpadeos -->
            <div id="bannerAvisoPrincipal" data-id="<%= aviso.id_aviso %>" style="display: none;"
                 class="relative bg-gradient-to-r <%= tema.gradient %> via-slate-900 to-slate-900 border-2 <%= tema.border %> rounded-2xl p-5 <%= tema.glow %> flex-col md:flex-row items-start md:items-center justify-between gap-5 transition-all">
                
                <div class="absolute -top-3 left-6 px-3 py-0.5 rounded-full <%= tema.badgeBg %> text-slate-950 text-[10px] font-black uppercase tracking-widest shadow-md flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-slate-950 animate-ping"></span>
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    Comunicado Oficial Importante
                </div>

                <div class="flex items-start gap-4 pt-1 md:pt-0">
                    <div class="w-12 h-12 rounded-2xl <%= tema.iconContainer %> flex items-center justify-center text-2xl shrink-0 shadow-inner mt-1">
                        <i class="fa-solid fa-bullhorn animate-bounce"></i>
                    </div>
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <h2 class="text-base font-extrabold text-white tracking-wide"><%= aviso.titulo %></h2>
                            <span class="px-2 py-0.5 text-[9px] font-extrabold <%= tema.tagBg %> rounded-md uppercase tracking-wider">
                                <%= tema.tagText %>
                            </span>
                        </div>
                        <p class="text-xs text-slate-200 leading-relaxed bg-slate-950/60 p-3 rounded-xl border border-slate-800/80 max-w-4xl shadow-inner">
                            <%= aviso.contenido %>
                        </p>
                        <p class="text-[10px] <%= tema.dateColor %> font-medium">
                            Publicado por <span class="text-white font-semibold"><%= aviso.autor_nombre %> <%= aviso.autor_apellido %></span> • <%= new Date(aviso.fecha_publicacion).toLocaleDateString('es-CL') %>
                        </p>
                    </div>
                </div>

                <div class="shrink-0 w-full md:w-auto flex md:flex-col items-center justify-end gap-2 pt-2 md:pt-0 border-t md:border-t-0 border-slate-700/50">
                    <a href="/apoderado/avisos" class="w-full md:w-auto px-5 py-2.5 <%= tema.btnBg %> text-slate-950 font-extrabold rounded-xl text-xs transition-all flex items-center justify-center gap-2 shadow-lg cursor-pointer">
                        <i class="fa-solid fa-layer-group"></i>
                        <span>Ver Historial (<%= numAvisos %>)</span>
                    </a>
                </div>
            </div>

            <!-- Evaluación síncrona inmediata antes del pintado del DOM -->
            <script>
                (function() {
                    const banner = document.getElementById('bannerAvisoPrincipal');
                    if (banner) {
                        const idAviso = parseInt(banner.getAttribute('data-id'), 10);
                        const vistosApoderado = JSON.parse(localStorage.getItem('avisos_vistos_apoderado') || '[]');
                        if (!vistosApoderado.includes(idAviso)) {
                            banner.style.display = 'flex';
                        }
                    }
                })();
            </script>
        <% } %>

        <!-- 1. ENCABEZADO PRINCIPAL Y KPIS -->
        <div class="bg-slate-900/90 p-6 rounded-2xl shadow-xl border border-slate-800 flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-teal-500/20 text-teal-400 border border-teal-500/30 flex items-center justify-center text-2xl shrink-0 shadow-inner">
                    <i class="fa-solid fa-users-between-lines"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-white">Panel del Apoderado</h1>
                    <p class="text-xs text-slate-400 mt-1">Bienvenido(a), <%= user ? (user.nombre + ' ' + user.apellido) : 'apoderado' %></p>
                </div>
            </div>

            <div class="grid grid-cols-3 gap-3 w-full md:w-auto">
                <div class="bg-slate-950/80 p-3 rounded-xl border border-slate-800 text-center min-w-[100px]">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">PUPILOS</p>
                    <p class="text-xl font-extrabold text-teal-400"><%= typeof estudiantes !== 'undefined' ? estudiantes.length : 0 %></p>
                </div>

                <!-- TARJETA KPI AVISOS CON COLOR ADAPTATIVO -->
                <a href="/apoderado/avisos" class="bg-slate-950/80 p-3 rounded-xl border <%= numAvisos > 0 ? tema.kpiBorder : 'border-slate-800' %> text-center min-w-[100px] flex flex-col items-center justify-center cursor-pointer hover:bg-slate-800 transition">
                    <div class="flex items-center gap-1 mb-0.5">
                        <p class="text-[10px] font-bold <%= numAvisos > 0 ? tema.kpiText : 'text-slate-400' %> uppercase tracking-wider">AVISOS</p>
                        <% if (numAvisos > 0) { %>
                            <span class="w-2 h-2 rounded-full <%= tema.badgeBg %> animate-ping"></span>
                        <% } %>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <i class="fa-solid fa-bell <%= tema.kpiText %> text-sm"></i>
                        <span class="text-xl font-extrabold text-white"><%= numAvisos %></span>
                    </div>
                </a>

                <% const pendientesChat = typeof mensajesPendientes !== 'undefined' ? mensajesPendientes : 0; %>
                <a href="/apoderado/mensajes" id="tarjetaChat" class="bg-slate-950/80 p-3 rounded-xl border <%= pendientesChat > 0 ? 'border-sky-500/60' : 'border-slate-800' %> text-center min-w-[100px] flex flex-col items-center justify-center cursor-pointer hover:bg-slate-800 transition">
                    <div class="flex items-center gap-1 mb-1">
                        <p class="text-[10px] font-bold <%= pendientesChat > 0 ? 'text-sky-300' : 'text-slate-400' %> uppercase tracking-wider" data-chat-titulo>CHAT</p>
                        <span data-chat-ping class="w-2 h-2 rounded-full bg-sky-400 animate-ping <%= pendientesChat > 0 ? '' : 'hidden' %>"></span>
                    </div>
                    <p class="text-xl font-extrabold text-sky-400 <%= pendientesChat > 0 ? 'hidden' : '' %>" data-chat-activo>Activo</p>
                    <p class="text-sm font-extrabold text-white leading-tight <%= pendientesChat > 0 ? '' : 'hidden' %>" data-chat-pendientes>
                        <i class="fa-solid fa-envelope text-sky-400 mr-1"></i><span data-chat-total><%= pendientesChat %></span> <span class="text-[10px] font-bold text-sky-300 uppercase">pendiente(s)</span>
                    </p>
                </a>
            </div>
        </div>

        <!-- 2. MÓDULOS OPERATIVOS REDISEÑADOS -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

            <!-- TARJETA 1: MIS PUPILOS -->
            <div class="group bg-slate-900/90 hover:bg-slate-900 p-6 rounded-2xl border border-slate-800 hover:border-teal-500/50 shadow-xl transition-all duration-300 flex flex-col justify-between relative overflow-hidden min-h-[380px]">
                <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-teal-500 to-emerald-400"></div>

                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-teal-500/20 text-teal-400 border border-teal-500/30 flex items-center justify-center text-lg shadow-inner">
                                <i class="fa-solid fa-user-graduate"></i>
                            </div>
                            <div>
                                <h2 class="font-extrabold text-white text-base tracking-wide">Mis Pupilos</h2>
                                <span class="text-[10px] font-bold text-teal-400/90 uppercase tracking-widest">Tutela Pedagógica</span>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-teal-500/10 text-teal-300 border border-teal-500/30">
                            <%= typeof estudiantes !== 'undefined' ? estudiantes.length : 0 %> Registrados
                        </span>
                    </div>

                    <p class="text-xs text-slate-300 leading-relaxed">
                        Vincula, consulta diagnósticos NEE y edita los expedientes de tus estudiantes asignados.
                    </p>

                    <!-- LISTADO DE PUPILOS CON ESTADOS EN TIEMPO REAL -->
                    <div class="space-y-2.5 max-h-48 overflow-y-auto pr-1">
                        <% if (typeof estudiantes !== 'undefined' && estudiantes.length > 0) { %>
                            <% estudiantes.forEach(est => { %>
                                <div class="p-3 rounded-xl border border-slate-800 bg-slate-950/70 hover:bg-slate-950 transition flex items-center justify-between gap-3">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <div class="w-8 h-8 rounded-full bg-teal-500/20 text-teal-300 font-bold text-xs border border-teal-500/30 flex items-center justify-center shrink-0 uppercase">
                                            <%= est.nombre.charAt(0) %><%= est.apellido.charAt(0) %>
                                        </div>
                                        <div class="min-w-0">
                                            <p class="text-xs font-bold text-white truncate capitalize"><%= est.nombre %> <%= est.apellido %></p>
                                            <p class="text-[10px] text-slate-400 truncate"><%= est.nombre_curso || 'Sin curso asignado' %></p>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-2 shrink-0">
                                        <!-- Insignia de Estado -->
                                        <% const estado = est.estado_inscripcion || 'PENDIENTE'; %>
                                        <% if (estado === 'PENDIENTE') { %>
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                                                En Espera
                                            </span>
                                        <% } else if (estado === 'APROBADO') { %>
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">
                                                ✓ Aprobado
                                            </span>
                                        <% } else if (estado === 'RECHAZADO') { %>
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/20 text-rose-300 border border-rose-500/40">
                                                ✕ Rechazado
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-800 text-slate-400 border border-slate-700">
                                                <%= estado %>
                                            </span>
                                        <% } %>

                                        <!-- Botón Editar -->
                                        <a href="/apoderado/editar-pupilo/<%= est.id_estudiante %>" class="p-2 bg-slate-800 hover:bg-teal-500/20 text-slate-300 hover:text-teal-300 rounded-lg text-xs transition border border-slate-700" title="Editar Expediente">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="text-center py-7 bg-slate-950/50 rounded-xl border border-dashed border-slate-800 space-y-1.5">
                                <i class="fa-solid fa-folder-open text-2xl text-slate-600 block"></i>
                                <p class="text-xs text-slate-400">No tienes pupilos registrados actualmente.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-800">
                    <a href="/apoderado/agregar-pupilo" class="w-full py-2.5 bg-gradient-to-r from-teal-600 to-teal-500 hover:from-teal-500 hover:to-teal-400 text-white font-bold rounded-xl text-xs transition-all flex items-center justify-center gap-2 shadow-lg shadow-teal-900/30">
                        <i class="fa-solid fa-plus text-xs"></i>
                        <span>Registrar Nuevo Pupilo</span>
                    </a>
                </div>
            </div>

            <!-- TARJETA 2: NOTAS Y DESEMPEÑO -->
            <div class="group bg-slate-900/90 hover:bg-slate-900 p-6 rounded-2xl border border-slate-800 hover:border-amber-500/50 shadow-xl transition-all duration-300 flex flex-col justify-between relative overflow-hidden min-h-[380px]">
                <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-500 to-orange-400"></div>

                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 border border-amber-500/30 flex items-center justify-center text-lg shadow-inner">
                                <i class="fa-solid fa-award"></i>
                            </div>
                            <div>
                                <h2 class="font-extrabold text-white text-base tracking-wide">Notas y Avance</h2>
                                <span class="text-[10px] font-bold text-amber-400/90 uppercase tracking-widest">Rendimiento Académico</span>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-amber-500/10 text-amber-300 border border-amber-500/30">
                            Actualizado
                        </span>
                    </div>

                    <p class="text-xs text-slate-300 leading-relaxed">
                        Accede al detalle completo de calificaciones por asignatura, evaluaciones diferenciadas y observaciones docentes.
                    </p>

                    <div class="p-4 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2.5">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-slate-400 flex items-center gap-1.5">
                                <i class="fa-solid fa-book-open text-amber-400 text-[11px]"></i> Registro Académico:
                            </span>
                            <span class="font-bold text-white">Disponible</span>
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-slate-400 flex items-center gap-1.5">
                                <i class="fa-solid fa-circle-check text-emerald-400 text-[11px]"></i> Observaciones:
                            </span>
                            <span class="font-bold text-emerald-400">Al día</span>
                        </div>
                        <p class="text-[11px] text-slate-400 pt-1 border-t border-slate-800">
                            Podrás seleccionar cada asignación para revisar promedios acumulados.
                        </p>
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-800">
                    <a href="/apoderado/notas-estu" class="w-full py-2.5 bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-slate-950 font-extrabold rounded-xl text-xs transition-all flex items-center justify-center gap-2 shadow-lg shadow-amber-900/30">
                        <i class="fa-solid fa-graduation-cap text-xs"></i>
                        <span>Consultar Informe de Notas</span>
                    </a>
                </div>
            </div>

            <!-- TARJETA 3: CHAT DOCENTE -->
            <div class="group bg-slate-900/90 hover:bg-slate-900 p-6 rounded-2xl border border-slate-800 hover:border-sky-500/50 shadow-xl transition-all duration-300 flex flex-col justify-between relative overflow-hidden min-h-[380px]">
                <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-sky-500 to-blue-500"></div>

                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-sky-500/20 text-sky-400 border border-sky-500/30 flex items-center justify-center text-lg shadow-inner">
                                <i class="fa-solid fa-comments"></i>
                            </div>
                            <div>
                                <h2 class="font-extrabold text-white text-base tracking-wide">Chat Docente</h2>
                                <span class="text-[10px] font-bold text-sky-400/90 uppercase tracking-widest">Atención a Apoderados</span>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-sky-500/10 text-sky-300 border border-sky-500/30">
                            Directo
                        </span>
                    </div>

                    <p class="text-xs text-slate-300 leading-relaxed">
                        Entabla conversaciones directas con los profesores jefes y especialistas del Programa PIE asignados a tus hijos.
                    </p>

                    <div class="p-4 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2.5">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-slate-400 flex items-center gap-1.5">
                                <i class="fa-solid fa-headset text-sky-400 text-[11px]"></i> Canal de Comunicación:
                            </span>
                            <span class="font-bold text-sky-300">Activo</span>
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-slate-400 flex items-center gap-1.5">
                                <i class="fa-solid fa-chalkboard-user text-teal-400 text-[11px]"></i> Equipo Docente:
                            </span>
                            <span class="font-bold text-white">Asignado</span>
                        </div>
                        <p class="text-[11px] text-slate-400 pt-1 border-t border-slate-800">
                            Escribe tus dudas, coordina reuniones o revisa respuestas de los educadores.
                        </p>
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-800">
                    <a href="/apoderado/mensajes" class="w-full py-2.5 bg-gradient-to-r from-sky-600 to-sky-500 hover:from-sky-500 hover:to-sky-400 text-white font-bold rounded-xl text-xs transition-all flex items-center justify-center gap-2 shadow-lg shadow-sky-900/30">
                        <i class="fa-solid fa-paper-plane text-xs"></i>
                        <span>Abrir Mensajería Directa</span>
                    </a>
                </div>
            </div>

        </div>

    </div>
</main>

<script src="/js/pendientes.js"></script>

<%- include('../partials/footer') %>