<%- include('../partials/header') %>

<div class="max-w-7xl mx-auto space-y-5 pb-8">
<% if (vacio) { %>
    <%- include('_vacio') %>
<% } else { %>
    <%- include('_nav', { volver: '/jefe/notas?curso=' + curso.id_curso_periodo, volverTitulo: 'Volver a notas' }) %>

    <% const colorProm = (n) => n === null ? 'text-slate-500' : (n >= 4 ? 'text-teal-400' : 'text-rose-400'); %>

    <div class="bg-slate-900/90 rounded-2xl border border-slate-800 shadow-xl p-5 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <div>
                <h2 class="text-lg font-bold text-white"><%= estudiante.nombre %> <%= estudiante.apellido %></h2>
                <p class="text-xs text-slate-400">RUT <%= estudiante.rut %><% if (estudiante.edad !== null) { %> &bull; <%= estudiante.edad %> años<% } %> &bull; <%= curso.nombre_curso %></p>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <% if (estudiante.nee) { %>
                <span class="px-3 py-1.5 rounded-lg text-[11px] font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30"><i class="fa-solid fa-brain mr-1"></i><%= estudiante.nee_clasificacion %> &bull; <%= estudiante.nee %></span>
                <span class="px-3 py-1.5 rounded-lg text-[11px] font-bold border <%= estudiante.fudei_estado === 'FINALIZADO' ? 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40' : 'bg-amber-500/20 text-amber-300 border-amber-500/40' %>">FUDEI <%= estudiante.fudei_estado === 'FINALIZADO' ? 'finalizado' : 'en proceso' %></span>
            <% } else { %>
                <span class="px-3 py-1.5 rounded-lg text-[11px] font-bold bg-slate-800 text-slate-400 border border-slate-700">Sin NEE registrada</span>
            <% } %>
            <a href="/jefe/informe/<%= estudiante.id_estudiante %>?curso=<%= curso.id_curso_periodo %>" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-gradient-to-r from-teal-500 to-emerald-600 text-slate-950 shadow-lg flex items-center gap-2"><i class="fa-solid fa-file-arrow-down"></i> Informe PDF</a>
        </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 text-center shadow-lg">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Promedio general</p>
            <p class="text-3xl font-black <%= colorProm(boletin.promedioGeneral) %>"><%= formatoNota(boletin.promedioGeneral) %></p>
        </div>
        <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 text-center shadow-lg">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Aprobadas</p>
            <p class="text-3xl font-black text-emerald-400"><%= boletin.resumen.aprobadas %><span class="text-sm text-slate-500 font-bold"> / <%= boletin.resumen.asignaturas %></span></p>
        </div>
        <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 text-center shadow-lg">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">En riesgo</p>
            <p class="text-3xl font-black <%= boletin.resumen.reprobadas > 0 ? 'text-rose-400' : 'text-slate-500' %>"><%= boletin.resumen.reprobadas %></p>
        </div>
        <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-4 text-center shadow-lg">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Asistencia</p>
            <p class="text-3xl font-black <%= asistencia.alerta ? 'text-rose-400' : 'text-sky-400' %>"><%= asistencia.porcentaje === null ? '-' : asistencia.porcentaje + '%' %></p>
            <p class="text-[10px] text-slate-400"><%= asistencia.presentes %> pres. &bull; <%= asistencia.tardanzas %> tard. &bull; <%= asistencia.ausentes %> aus.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
        <div class="lg:col-span-8 space-y-3">
            <% boletin.asignaturas.forEach((asig) => { %>
                <details open class="bg-slate-900/90 border border-slate-800 rounded-2xl shadow-lg overflow-hidden">
                    <summary class="cursor-pointer list-none p-4 sm:px-5 flex flex-wrap items-center justify-between gap-3">
                        <div class="min-w-0">
                            <h3 class="text-sm font-bold text-white truncate"><%= asig.nombre %></h3>
                            <p class="text-[11px] text-slate-400 truncate"><%= asig.profesor %> &bull; <%= asig.calificadas %> de <%= asig.total %> evaluaciones</p>
                        </div>
                        <span class="text-xl font-black <%= colorProm(asig.promedio) %>"><%= formatoNota(asig.promedio) %></span>
                    </summary>
                    <div class="px-4 sm:px-5 pb-4 border-t border-slate-800">
                        <% if (asig.evaluaciones.length === 0) { %>
                            <p class="py-3 text-xs text-slate-500">Sin evaluaciones registradas.</p>
                        <% } else { %>
                            <table class="w-full text-left text-xs mt-2">
                                <thead><tr class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                                    <th class="py-2 pr-3">Evaluación</th><th class="py-2 px-3">Fecha</th><th class="py-2 px-3 text-center">Pond.</th><th class="py-2 px-3 text-center">Puntaje</th><th class="py-2 pl-3 text-center">Nota</th>
                                </tr></thead>
                                <tbody class="divide-y divide-slate-800">
                                    <% asig.evaluaciones.forEach((ev) => { %>
                                        <tr>
                                            <td class="py-2 pr-3 font-semibold text-slate-100"><%= ev.nombre %></td>
                                            <td class="py-2 px-3 text-slate-300 whitespace-nowrap"><%= formatoFecha(ev.fecha) %></td>
                                            <td class="py-2 px-3 text-center text-slate-300"><%= ev.porcentaje %>%</td>
                                            <td class="py-2 px-3 text-center text-slate-300"><%= ev.puntaje === null ? '-' : ev.puntaje + ' / ' + ev.puntajeMaximo %></td>
                                            <td class="py-2 pl-3 text-center font-black <%= colorProm(ev.nota) %>"><%= formatoNota(ev.nota) %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        <% } %>
                        <% if (asig.observacion) { %>
                            <p class="mt-3 text-[11px] text-slate-300 bg-slate-950/60 border border-slate-800 rounded-xl px-3 py-2"><i class="fa-solid fa-comment-dots text-sky-400 mr-1"></i><span class="font-bold text-slate-200">Observación:</span> <%= asig.observacion %></p>
                        <% } %>
                    </div>
                </details>
            <% }) %>
        </div>

        <div class="lg:col-span-4 space-y-5">
            <div class="bg-slate-900/90 rounded-2xl border border-slate-800 shadow-xl p-5 space-y-3">
                <h3 class="text-sm font-bold text-white flex items-center gap-2"><i class="fa-solid fa-people-roof text-amber-400"></i> Apoderados</h3>
                <% if (apoderados.length === 0) { %>
                    <p class="text-xs text-slate-400">Sin apoderados vinculados.</p>
                <% } else { %>
                    <% apoderados.forEach((a) => { %>
                        <div class="text-xs space-y-0.5 pb-2 border-b border-slate-800 last:border-0">
                            <p class="font-bold text-slate-100"><%= a.nombre_completo %> <span class="font-normal text-slate-400">(<%= (a.pupilos.find((p) => p.id_estudiante === estudiante.id_estudiante) || {}).parentesco || 'Apoderado' %>)</span></p>
                            <p class="text-slate-300"><i class="fa-solid fa-envelope w-4 text-slate-500"></i><%= a.correo || 'Sin correo' %></p>
                            <p class="text-slate-300"><i class="fa-solid fa-phone w-4 text-slate-500"></i><%= a.telefono || 'Sin teléfono' %></p>
                        </div>
                    <% }) %>
                    <a href="/profesor/atencionApo?estudiante=<%= estudiante.id_estudiante %>" class="w-full py-2 rounded-xl text-xs font-bold bg-sky-500/20 hover:bg-sky-500 text-sky-300 hover:text-white border border-sky-500/30 transition flex items-center justify-center gap-2"><i class="fa-solid fa-comments"></i> Enviar mensaje</a>
                <% } %>
            </div>
        </div>
    </div>
<% } %>
</div>
<%- include('../partials/footer') %>
