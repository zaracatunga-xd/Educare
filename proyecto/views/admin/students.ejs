<%- include('partials/header') %>

<div class="space-y-6">

    <!-- Botón Volver al Panel -->
    <div>
        <a href="/admin" class="inline-flex items-center gap-2 bg-slate-800/90 hover:bg-slate-700 text-slate-200 hover:text-white text-sm font-semibold px-4 py-2.5 rounded-xl border border-slate-700/80 transition-all shadow-md">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Volver al Panel</span>
        </a>
    </div>

    <!-- Banner Superior -->
    <div class="bg-gradient-to-r from-blue-600 to-blue-800 rounded-2xl p-6 text-white shadow-lg flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <div class="flex items-center gap-3">
                <i class="fa-solid fa-user-graduate text-2xl"></i>
                <h2 class="text-2xl font-bold">Gestión de Estudiantes</h2>
            </div>
            <p class="text-blue-100 text-sm mt-1">
                <% if (locals.user) { %>
                    Bienvenido, <%= user.nombre %> <%= user.apellido %> (<%= user.rol %>)
                <% } else { %>
                    Panel exclusivo de Administrador
                <% } %>
            </p>
        </div>
        <div class="bg-blue-900/50 px-5 py-2.5 rounded-xl text-center min-w-[110px]">
            <span class="block text-2xl font-bold text-amber-400"><%= students ? students.length : 0 %></span>
            <span class="text-xs text-blue-200">Estudiantes</span>
        </div>
    </div>

    <!-- Barra de Filtro por Curso -->
    <div class="bg-slate-800/80 border border-slate-700/60 rounded-2xl p-4 flex flex-col sm:flex-row justify-between items-center gap-4">
        <div class="text-slate-300 text-sm font-medium flex items-center gap-2">
            <i class="fa-solid fa-filter text-blue-400"></i>
            <span>Filtrar por curso:</span>
        </div>
        <form method="GET" action="/admin/students" class="w-full sm:w-auto flex items-center gap-3">
            <select name="id_curso" onchange="this.form.submit()" class="bg-slate-900 border border-slate-700 text-slate-200 text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none w-full sm:w-64">
                <option value="">-- Todos los Cursos --</option>
                <% if (locals.cursos && cursos.length > 0) { %>
                    <% cursos.forEach(curso => { %>
                        <option value="<%= curso.id_curso_periodo %>" <%= (locals.selectedCourse && selectedCourse == curso.id_curso_periodo) ? 'selected' : '' %>>
                            <%= curso.nombre_curso %>
                        </option>
                    <% }); %>
                <% } %>
            </select>
            <% if (locals.selectedCourse) { %>
                <a href="/admin/students" class="text-xs text-slate-400 hover:text-white underline whitespace-nowrap">Limpiar</a>
            <% } %>
        </form>
    </div>

    <!-- Mensaje de Error -->
    <% if (locals.error) { %>
        <div class="bg-red-900/50 border border-red-700 text-red-200 px-4 py-3 rounded-xl text-sm">
            <i class="fa-solid fa-circle-exclamation mr-2"></i> <%= error %>
        </div>
    <% } %>

    <!-- Tabla de Estudiantes -->
    <div class="bg-slate-800/80 rounded-2xl border border-slate-700/60 overflow-hidden shadow-xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="border-b border-slate-700/80 text-xs font-semibold text-slate-300 uppercase tracking-wider bg-slate-900/40">
                        <th class="py-4 px-6">RUT</th>
                        <th class="py-4 px-6">ESTUDIANTE</th>
                        <th class="py-4 px-6">CURSO / NIVEL</th>
                        <th class="py-4 px-6">PERIODO</th>
                        <th class="py-4 px-6 text-center">ACCIONES</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-700/50 text-slate-200">
                    <% if (students && students.length > 0) { %>
                        <% students.forEach(student => { %>
                            <% const studentId = student.id_estudiante || student.id_usuario || student.id_persona || student.id; %>
                            <tr class="hover:bg-slate-700/30 transition-colors">
                                <!-- RUT -->
                                <td class="py-4 px-6 font-mono font-medium text-slate-300">
                                    <%= student.rut || '00000000-0' %>
                                </td>

                                <!-- Nombre y Género / Correo -->
                                <td class="py-4 px-6">
                                    <div class="font-bold text-white capitalize">
                                        <%= student.nombre %> <%= student.apellido %>
                                    </div>
                                    <div class="text-xs text-slate-400">
                                        <%= student.correo || student.genero || 'N/A' %>
                                    </div>
                                </td>

                                <!-- Curso / Nivel -->
                                <td class="py-4 px-6">
                                    <% if (student.nombre_curso) { %>
                                        <span class="bg-blue-900/60 text-blue-200 border border-blue-500/40 text-xs font-semibold px-3 py-1 rounded-lg">
                                            <%= student.nombre_curso %>
                                        </span>
                                    <% } else if (student.nivel && student.seccion) { %>
                                        <span class="bg-blue-900/60 text-blue-200 border border-blue-500/40 text-xs font-semibold px-3 py-1 rounded-lg">
                                            <%= student.nivel %> - <%= student.seccion %>
                                        </span>
                                    <% } else { %>
                                        <span class="text-xs italic text-slate-500">Sin asignar</span>
                                    <% } %>
                                </td>

                                <!-- Periodo -->
                                <td class="py-4 px-6 text-slate-300 text-xs">
                                    <% if (student.año && student.semestre) { %>
                                        <%= student.año %> (Sem. <%= student.semestre %>)
                                    <% } else { %>
                                        <span class="text-slate-500">Actual</span>
                                    <% } %>
                                </td>

                                <!-- Acciones (Ver Detalle / Eliminar) -->
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <div class="flex items-center gap-2">
                                <!-- Botón Editar con estilo de botón pill -->
                                    <a href="/admin/student-edit/<%= student.id_estudiante || student.id_persona %>" 
                                                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/30 text-xs font-semibold rounded-xl transition shadow-sm">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        <span>Editar</span>
                                    </a>
                                <!-- Botón Eliminar -->
                                <form action="/admin/students-delete/<%= student.id_estudiante || student.id_persona %>" method="POST" class="inline" onsubmit="return confirm('¿Seguro que deseas eliminar a este estudiante?');">
                                    <button type="submit" 
                                        class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-red-500/20 hover:bg-red-500/30 text-red-300 border border-red-500/30 text-xs font-semibold rounded-xl transition shadow-sm">
                                        <i class="fa-solid fa-trash-can"></i>
                                        <span>Eliminar</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                        </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="5" class="py-8 text-center text-slate-400">
                                No se encontraron estudiantes registrados.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Script SweetAlert2 para Confirmación y Éxito -->
<script>
    function confirmarEliminarEstudiante(event, form, nombre) {
        event.preventDefault();

        Swal.fire({
            title: "¿Estás seguro?",
            text: `Vas a eliminar a ${nombre || 'este estudiante'}. Esta acción no se puede deshacer.`,
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#ef4444",
            cancelButtonColor: "#64748b",
            confirmButtonText: "Sí, eliminar",
            cancelButtonText: "Cancelar",
            background: "#1e293b",
            color: "#f8fafc"
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            }
        });
    }

    // Mostrar alerta de éxito tras ser redirigido
    document.addEventListener("DOMContentLoaded", () => {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('deleted') === 'true') {
            Swal.fire({
                title: "¡Eliminado!",
                text: "El estudiante ha sido eliminado correctamente del sistema.",
                icon: "success",
                confirmButtonColor: "#2563eb",
                background: "#1e293b",
                color: "#f8fafc"
            });
            // Limpiar el parámetro de la URL sin recargar la página
            window.history.replaceState({}, document.title, window.location.pathname);
        } else if (urlParams.get('updated') === 'true') {
            Swal.fire({
                title: "¡Actualizado!",
                text: "Los datos del estudiante fueron modificados exitosamente.",
                icon: "success",
                confirmButtonColor: "#2563eb",
                background: "#1e293b",
                color: "#f8fafc"
            });
            window.history.replaceState({}, document.title, window.location.pathname);
        } else if (urlParams.get('error')) {
            Educare.notificar('error', 'No se pudo guardar', urlParams.get('error'));
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    });
</script>

<%- include('partials/footer') %>