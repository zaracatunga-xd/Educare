<%- include('partials/header') %>

<div class="space-y-6">

    <!-- Botón Volver al Panel -->
    <div>
        <a href="/admin" class="inline-flex items-center gap-2 bg-slate-800/90 hover:bg-slate-700 text-slate-200 hover:text-white text-sm font-semibold px-4 py-2.5 rounded-xl border border-slate-700/80 transition-all shadow-md">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Volver al Panel</span>
        </a>
    </div>

    <!-- Encabezado de la Sección -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
        <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center text-xl">
                <i class="fa-solid fa-user-clock"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-slate-800">Solicitudes de Registro</h1>
                <p class="text-sm text-slate-500">Gestiona las cuentas pendientes de aprobación en la plataforma</p>
            </div>
        </div>
        
        <!-- Contador de pendientes -->
        <div class="flex items-center gap-2">
            <span class="px-3 py-1.5 bg-amber-100 text-amber-800 text-xs font-semibold rounded-lg flex items-center gap-1.5">
                <i class="fa-solid fa-clock"></i>
                <%= usuarios ? usuarios.filter(u => String(u.estado || '').toUpperCase().trim() === 'P').length : 0 %> Pendientes
            </span>
        </div>
    </div>

    <!-- Grid de Tarjetas de Usuarios Pendientes -->
    <% if (usuarios && usuarios.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% usuarios.forEach(u => { %>
                <% const estadoNorm = String(u.estado || '').toUpperCase().trim(); %>
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 flex flex-col justify-between transition hover:shadow-md">
                    
                    <div>
                        <!-- Cabecera de la Tarjeta: Usuario y Rol -->
                        <div class="flex items-start justify-between gap-3 mb-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 font-bold text-sm uppercase">
                                    <%= u.nombre ? u.nombre.charAt(0) : '' %><%= u.apellido ? u.apellido.charAt(0) : '' %>
                                </div>
                                <div>
                                    <h3 class="font-bold text-slate-800 text-base leading-tight">
                                        <%= u.nombre %> <%= u.apellido %>
                                    </h3>
                                    <span class="inline-block text-xs font-medium text-teal-600">
                                        <i class="fa-solid <%= u.rol_nombre === 'Profesor' ? 'fa-chalkboard-user' : (u.rol_nombre === 'Apoderado' ? 'fa-users-line' : 'fa-user-graduate') %> mr-1"></i>
                                        <%= u.rol_nombre || 'Sin Rol' %>
                                    </span>
                                </div>
                            </div>

                            <!-- Badge de Estado -->
                            <% if (estadoNorm === 'P') { %>
                                <span class="px-2.5 py-1 bg-amber-100 text-amber-800 text-xs font-semibold rounded-full border border-amber-200 shrink-0">
                                    Pendiente
                                </span>
                            <% } else if (estadoNorm === 'A') { %>
                                <span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 text-xs font-semibold rounded-full border border-emerald-200 shrink-0">
                                    Aprobado
                                </span>
                            <% } else { %>
                                <span class="px-2.5 py-1 bg-red-100 text-red-800 text-xs font-semibold rounded-full border border-red-200 shrink-0">
                                    Rechazado
                                </span>
                            <% } %>
                        </div>

                        <!-- Detalle de la Solicitud -->
                        <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-100 mb-4 space-y-2">
                            <div>
                                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">RUT</p>
                                <p class="text-xs font-medium text-slate-700"><%= u.rut || 'No especificado' %></p>
                            </div>
                            <div>
                                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Correo electrónico</p>
                                <p class="text-xs font-medium text-slate-700 truncate"><%= u.correo %></p>
                            </div>
                        </div>

                        <div class="text-xs text-slate-400 mb-4 flex items-center gap-1.5">
                            <i class="fa-regular fa-calendar"></i>
                            <span>Fecha de solicitud: <%= new Date(u.fecha_creacion).toLocaleDateString('es-CL') %></span>
                        </div>
                    </div>

                    <!-- Botones de Acción con SweetAlert2 -->
                    <% if (estadoNorm === 'P') { %>
                        <div class="pt-3 border-t border-slate-100 grid grid-cols-2 gap-3">
                            <!-- Rechazar -->
                            <form action="/admin/usuarios/<%= u.id_usuario %>/rechazar" method="POST">
                                <button type="button" 
                                        onclick="confirmarAccionSolicitud(event, this.form, 'rechazar', '<%= u.nombre %> <%= u.apellido %>')"
                                        class="w-full py-2 px-3 bg-red-50 hover:bg-red-100 text-red-600 font-semibold rounded-xl text-xs transition flex items-center justify-center gap-1.5 border border-red-200 cursor-pointer">
                                    <i class="fa-solid fa-xmark"></i> Rechazar
                                </button>
                            </form>

                            <!-- Aprobar -->
                            <form action="/admin/usuarios/<%= u.id_usuario %>/aprobar" method="POST">
                                <button type="button" 
                                        onclick="confirmarAccionSolicitud(event, this.form, 'aprobar', '<%= u.nombre %> <%= u.apellido %>')"
                                        class="w-full py-2 px-3 bg-teal-600 hover:bg-teal-700 text-white font-semibold rounded-xl text-xs shadow-sm transition flex items-center justify-center gap-1.5 cursor-pointer">
                                    <i class="fa-solid fa-check"></i> Aprobar
                                </button>
                            </form>
                        </div>
                    <% } else { %>
                        <div class="pt-3 border-t border-slate-100 text-center">
                            <span class="text-xs text-slate-400 italic">Estado finalizado</span>
                        </div>
                    <% } %>

                </div>
            <% }); %>
        </div>
    <% } else { %>
        <!-- Estado Vacío -->
        <div class="bg-white p-12 rounded-2xl shadow-sm border border-slate-100 text-center">
            <div class="w-16 h-16 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                <i class="fa-solid fa-user-check"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-800">No hay cuentas pendientes</h3>
            <p class="text-sm text-slate-500 mt-1">Todas las solicitudes de registro han sido procesadas.</p>
        </div>
    <% } %>
</div>

<!-- Script SweetAlert2 para Confirmación y Pop-ups de Resultado -->
<script>
    function confirmarAccionSolicitud(event, form, tipo, nombre) {
        event.preventDefault();
        const esAprobar = tipo === 'aprobar';

        Swal.fire({
            title: esAprobar ? "¿Aprobar usuario?" : "¿Rechazar solicitud?",
            text: esAprobar 
                ? `¿Estás seguro de que deseas APROBAR a ${nombre || 'este usuario'} para que acceda a la plataforma?` 
                : `¿Estás seguro de que deseas RECHAZAR la solicitud de ${nombre || 'este usuario'}?`,
            icon: esAprobar ? "question" : "warning",
            showCancelButton: true,
            confirmButtonColor: esAprobar ? "#0d9488" : "#ef4444",
            cancelButtonColor: "#64748b",
            confirmButtonText: esAprobar ? "Sí, aprobar" : "Sí, rechazar",
            cancelButtonText: "Cancelar",
            background: "#1e293b",
            color: "#f8fafc"
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            }
        });
    }

    // Activar alertas SweetAlert2 tras redirigir del backend
    document.addEventListener("DOMContentLoaded", () => {
        const urlParams = new URLSearchParams(window.location.search);

        if (urlParams.get('approved') === 'true') {
            Swal.fire({
                title: "¡Usuario Aprobado!",
                text: "La cuenta ha sido activada e ingresada correctamente al sistema.",
                icon: "success",
                confirmButtonColor: "#0d9488",
                background: "#1e293b",
                color: "#f8fafc"
            });
            window.history.replaceState({}, document.title, window.location.pathname);
        } else if (urlParams.get('rejected') === 'true') {
            Swal.fire({
                title: "Solicitud Rechazada",
                text: "La solicitud de registro ha sido rechazada exitosamente.",
                icon: "info",
                confirmButtonColor: "#ef4444",
                background: "#1e293b",
                color: "#f8fafc"
            });
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    });
</script>

<%- include('partials/footer') %>