<%- include('partials/header') %>

<div class="max-w-3xl mx-auto space-y-6">

    <!-- Botón Volver a Apoderados -->
    <div>
        <a href="/admin/apoderadoA" class="inline-flex items-center gap-2 bg-slate-800/90 hover:bg-slate-700 text-slate-200 hover:text-white text-sm font-semibold px-4 py-2.5 rounded-xl border border-slate-700/80 transition-all shadow-md">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Volver a Apoderados</span>
        </a>
    </div>

    <!-- Tarjeta del Formulario -->
    <div class="bg-slate-800/80 rounded-2xl border border-slate-700/60 p-6 shadow-xl text-slate-200">
        <div class="flex items-center gap-3 border-b border-slate-700/80 pb-4 mb-6">
            <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-lg">
                <i class="fa-solid fa-user-pen"></i>
            </div>
            <div>
                <h2 class="text-xl font-bold text-white">Editar Apoderado</h2>
                <p class="text-xs text-slate-400">Modifica los datos personales y de contacto del apoderado</p>
            </div>
        </div>

        <% if (locals.error) { %>
            <div class="bg-red-900/50 border border-red-700 text-red-200 px-4 py-3 rounded-xl text-sm mb-6">
                <i class="fa-solid fa-circle-exclamation mr-2"></i> <%= error %>
            </div>
        <% } %>

        <form action="/admin/apoderado-edit/<%= apoderado.id_usuario %>" method="POST" class="space-y-4">
            <input type="hidden" name="id_persona" value="<%= apoderado.id_persona %>">
            <input type="hidden" name="id_apoderado" value="<%= apoderado.id_apoderado %>">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- RUT -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">RUT</label>
                    <input type="text" name="rut" value="<%= apoderado.rut %>" required class="w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>

                <!-- Correo -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Correo Electrónico</label>
                    <input type="email" name="correo" value="<%= apoderado.correo %>" required class="w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>

                <!-- Nombre -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Nombre</label>
                    <input type="text" name="nombre" value="<%= apoderado.nombre %>" required class="w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>

                <!-- Apellido -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Apellido</label>
                    <input type="text" name="apellido" value="<%= apoderado.apellido %>" required class="w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>

                <!-- Fecha de Nacimiento -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Fecha de Nacimiento</label>
                    <input type="date" data-date-rule="birth-adult" name="fecha_nacimiento" value="<%= apoderado.fecha_nacimiento || '' %>" class="w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>

                <!-- Género -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Género</label>
                    <select name="genero" class="w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                        <option value="Masculino" <%= apoderado.genero === 'Masculino' ? 'selected' : '' %>>Masculino</option>
                        <option value="Femenino" <%= apoderado.genero === 'Femenino' ? 'selected' : '' %>>Femenino</option>
                        <option value="Otro" <%= apoderado.genero === 'Otro' ? 'selected' : '' %>>Otro</option>
                    </select>
                </div>

                <!-- Teléfono (Abarca ambas columnas si no hay más campos) -->
                <div class="md:col-span-2">
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Teléfono Contacto</label>
                    <input type="text" name="telefono" value="<%= apoderado.telefono || '' %>" placeholder="+56 9 ..." class="w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>
            </div>

            <!-- Botones -->
            <div class="pt-4 flex justify-end gap-3 border-t border-slate-700/80 mt-6">
                <a href="/admin/apoderadoA" class="px-5 py-2.5 rounded-xl border border-slate-600 text-slate-300 hover:bg-slate-700 text-sm font-semibold transition">
                    Cancelar
                </a>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold shadow-md transition">
                    Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>