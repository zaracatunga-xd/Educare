<%- include('partials/header') %>

<div class="space-y-6">

    <!-- Botón Volver al Panel -->
    <div>
        <a href="/admin" class="inline-flex items-center gap-2 bg-slate-800/90 hover:bg-slate-700 text-slate-200 hover:text-white text-sm font-semibold px-4 py-2.5 rounded-xl border border-slate-700/80 transition-all shadow-md">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Volver al Panel</span>
        </a>
    </div>

    <!-- Encabezado Azul para Apoderados -->
    <div class="bg-gradient-to-r from-blue-600 to-blue-800 rounded-2xl p-6 text-white shadow-lg flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <div class="flex items-center gap-3">
                <i class="fa-solid fa-users-line text-2xl"></i>
                <h2 class="text-2xl font-bold">Gestión de Apoderados</h2>
            </div>
            <p class="text-blue-100 text-sm mt-1">Panel exclusivo de Administrador</p>
        </div>
        <div class="bg-blue-900/60 px-5 py-2.5 rounded-xl text-center min-w-[110px]">
            <span class="block text-2xl font-bold text-amber-400"><%= apoderados ? apoderados.length : 0 %></span>
            <span class="text-xs text-blue-200">Apoderados</span>
        </div>
    </div>

    <!-- Mensaje de Error (si existe) -->
    <% if (locals.error || error) { %>
        <div class="bg-red-900/50 border border-red-700 text-red-200 px-4 py-3 rounded-xl text-sm">
            <i class="fa-solid fa-circle-exclamation mr-2"></i> <%= error %>
        </div>
    <% } %>

    <!-- Tabla de Apoderados -->
    <% if (apoderados && apoderados.length > 0) { %>
        <div class="bg-slate-800/80 rounded-2xl shadow-xl border border-slate-700/60 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="border-b border-slate-700/80 text-xs font-semibold text-slate-300 uppercase tracking-wider bg-slate-900/40">
                            <th class="px-6 py-4">RUT</th>
                            <th class="px-6 py-4">Apoderado</th>
                            <th class="px-6 py-4">Teléfono</th>
                            <th class="px-6 py-4">Dirección</th>
                            <th class="px-6 py-4 text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700/50 text-slate-200">
                        <% apoderados.forEach(function(apoderado) { %>
                            <% 
                                const apoId = apoderado.id_usuario || apoderado.id_apoderado || apoderado.id_persona;
                                
                                // Formatear fecha para el input type="date"
                                let fechaFmt = '';
                                if (apoderado.fecha_nacimiento) {
                                    fechaFmt = new Date(apoderado.fecha_nacimiento).toISOString().split('T')[0];
                                }
                            %>
                            <tr class="hover:bg-slate-700/30 transition-colors">
                                <!-- RUT -->
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-300 font-mono font-medium">
                                    <%= apoderado.rut || 'Sin RUT' %>
                                </td>

                                <!-- Nombre y Correo -->
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-bold text-white capitalize">
                                        <%= apoderado.nombre %> <%= apoderado.apellido %>
                                    </div>
                                    <div class="text-xs text-slate-400">
                                        <%= apoderado.correo || 'Sin correo' %>
                                    </div>
                                </td>

                                <!-- Teléfono -->
                                <td class="px-6 py-4 whitespace-nowrap text-xs text-slate-300">
                                    <%= apoderado.telefono || 'No registrado' %>
                                </td>

                                <!-- Dirección -->
                                <td class="px-6 py-4 whitespace-nowrap text-xs text-slate-300">
                                    <%= apoderado.direccion || 'No registrada' %>
                                </td>

                                <!-- Acciones -->
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <!-- Botón Editar que activa el Pop-Up Modal -->
                                        <button type="button" 
                                                onclick="abrirModalApoderado(this)"
                                                data-id_usuario="<%= apoId %>"
                                                data-id_persona="<%= apoderado.id_persona || '' %>"
                                                data-id_apoderado="<%= apoderado.id_apoderado || '' %>"
                                                data-rut="<%= apoderado.rut || '' %>"
                                                data-correo="<%= apoderado.correo || '' %>"
                                                data-nombre="<%= apoderado.nombre || '' %>"
                                                data-apellido="<%= apoderado.apellido || '' %>"
                                                data-fecha_nacimiento="<%= fechaFmt %>"
                                                data-genero="<%= apoderado.genero || 'Masculino' %>"
                                                data-telefono="<%= apoderado.telefono || '' %>"
                                                data-direccion="<%= apoderado.direccion || '' %>"
                                                class="bg-amber-100/90 hover:bg-amber-200 text-amber-900 text-xs font-semibold px-3 py-1.5 rounded-lg border border-amber-300/50 flex items-center gap-1.5 transition-all cursor-pointer">
                                            <i class="fa-solid fa-pen-to-square text-xs"></i> Editar
                                        </button>

                                        <!-- Botón Eliminar -->
                                        <form action="/admin/apoderados-delete/<%= apoId %>" method="POST" class="inline">
                                            <button type="button" 
                                                    onclick="confirmarEliminarApoderado(event, this.form, '<%= apoderado.nombre %> <%= apoderado.apellido %>')"
                                                    class="bg-rose-100/90 hover:bg-rose-200 text-rose-900 text-xs font-semibold px-3 py-1.5 rounded-lg border border-rose-300/50 flex items-center gap-1.5 transition-all cursor-pointer">
                                                <i class="fa-solid fa-trash text-xs"></i> Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } else { %>
        <div class="bg-slate-800/80 rounded-2xl shadow-xl border border-slate-700/60 p-8 text-center text-slate-300">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-700/50 text-slate-400 mb-4">
                <i class="fa-solid fa-users-line text-3xl"></i>
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">No hay apoderados registrados</h3>
            <p class="text-sm text-slate-400">Actualmente no existen usuarios con el rol de apoderado en el sistema.</p>
        </div>
    <% } %>
</div>

<!-- POP-UP MODAL EDITAR APODERADO -->
<div id="modalEditarApoderado" style="display: none;" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-slate-800 rounded-2xl border border-slate-700/60 p-6 shadow-2xl w-full max-w-3xl text-slate-200 my-8">
        
        <!-- Encabezado del Modal -->
        <div class="flex items-center justify-between border-b border-slate-700/80 pb-4 mb-6">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-lg">
                    <i class="fa-solid fa-user-pen"></i>
                </div>
                <div>
                    <h2 class="text-xl font-bold text-white">Editar Apoderado</h2>
                    <p class="text-xs text-slate-400">Modifica los datos personales y de contacto del apoderado</p>
                </div>
            </div>
            <button type="button" onclick="cerrarModalApoderado()" class="text-slate-400 hover:text-white p-2 text-lg">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <!-- Formulario -->
        <form id="formEditarApoderado" action="" method="POST" class="space-y-4">
            <input type="hidden" id="edit_id_persona" name="id_persona">
            <input type="hidden" id="edit_id_apoderado" name="id_apoderado">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- RUT -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">RUT</label>
                    <input type="text" id="edit_rut" name="rut" required class="w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none font-mono">
                </div>

                <!-- Correo -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Correo Electrónico</label>
                    <input type="email" id="edit_correo" name="correo" required class="w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>

                <!-- Nombre -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Nombre</label>
                    <input type="text" id="edit_nombre" name="nombre" required class="w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>

                <!-- Apellido -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Apellido</label>
                    <input type="text" id="edit_apellido" name="apellido" required class="w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>

                <!-- Fecha de Nacimiento -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Fecha de Nacimiento</label>
                    <input type="date" data-date-rule="birth-adult" id="edit_fecha_nacimiento" name="fecha_nacimiento" class="w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>

                <!-- Género -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Género</label>
                    <select id="edit_genero" name="genero" class="w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                        <option value="Masculino">Masculino</option>
                        <option value="Femenino">Femenino</option>
                        <option value="Otro">Otro</option>
                    </select>
                </div>

                <!-- Teléfono -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Teléfono Contacto</label>
                    <input type="text" id="edit_telefono" name="telefono" placeholder="+56 9 ..." class="w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>

                <!-- Dirección -->
                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Dirección</label>
                    <input type="text" id="edit_direccion" name="direccion" placeholder="Calle, número, comuna" class="w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                </div>
            </div>

            <!-- Botones de Acción -->
            <div class="pt-4 flex justify-end gap-3 border-t border-slate-700/80 mt-6">
                <button type="button" onclick="cerrarModalApoderado()" class="px-5 py-2.5 rounded-xl border border-slate-600 text-slate-300 hover:bg-slate-700 text-sm font-semibold transition">
                    Cancelar
                </button>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold shadow-md transition">
                    Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>

<!-- SCRIPTS -->
<script>
    function abrirModalApoderado(btn) {
        const d = btn.dataset;

        // Configura la ruta de envío POST dinámicamente con la ID del usuario
        document.getElementById('formEditarApoderado').action = '/admin/apoderado-edit/' + d.id_usuario;

        // Rellena los inputs con los datos del botón
        document.getElementById('edit_id_persona').value = d.id_persona || '';
        document.getElementById('edit_id_apoderado').value = d.id_apoderado || '';
        document.getElementById('edit_rut').value = d.rut || '';
        document.getElementById('edit_correo').value = d.correo || '';
        document.getElementById('edit_nombre').value = d.nombre || '';
        document.getElementById('edit_apellido').value = d.apellido || '';
        document.getElementById('edit_fecha_nacimiento').value = d.fecha_nacimiento || '';
        document.getElementById('edit_genero').value = d.genero || 'Masculino';
        document.getElementById('edit_telefono').value = d.telefono || '';
        document.getElementById('edit_direccion').value = d.direccion || '';

        // Muestra el modal
        const modal = document.getElementById('modalEditarApoderado');
        if (modal) {
            modal.style.display = 'flex';
        }
    }

    function cerrarModalApoderado() {
        const modal = document.getElementById('modalEditarApoderado');
        if (modal) {
            modal.style.display = 'none';
        }
    }

    function confirmarEliminarApoderado(event, form, nombre) {
        event.preventDefault();

        Swal.fire({
            title: "¿Estás seguro?",
            text: `Vas a eliminar al apoderado ${nombre || 'seleccionado'}. Se desvincularán sus accesos y registros del sistema.`,
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#ef4444",
            cancelButtonColor: "#64748b",
            confirmButtonText: "Sí, eliminar",
            cancelButtonText: "Cancelar",
            background: "#1e293b",
            color: "#f8fafc"
        }).then((result) => {
            if (result.isConfirmed) {
                form.submit();
            }
        });
    }

    // Alertas emergentes tras actualizar o eliminar
    document.addEventListener("DOMContentLoaded", () => {
        const urlParams = new URLSearchParams(window.location.search);

        if (urlParams.get('deleted') === 'true') {
            Swal.fire({
                title: "¡Eliminado!",
                text: "El apoderado ha sido eliminado correctamente del sistema.",
                icon: "success",
                confirmButtonColor: "#2563eb",
                background: "#1e293b",
                color: "#f8fafc"
            });
            window.history.replaceState({}, document.title, window.location.pathname);
        } else if (urlParams.get('updated') === 'true') {
            Swal.fire({
                title: "¡Actualizado!",
                text: "Los datos del apoderado fueron modificados exitosamente.",
                icon: "success",
                confirmButtonColor: "#2563eb",
                background: "#1e293b",
                color: "#f8fafc"
            });
            window.history.replaceState({}, document.title, window.location.pathname);
        } else if (urlParams.get('error')) {
            Educare.notificar('error', 'No se pudo guardar', urlParams.get('error'));
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    });
</script>

<%- include('partials/footer') %>