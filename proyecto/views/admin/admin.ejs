<%- include('../partials/header') %>

<main class="min-h-screen bg-slate-950 py-8 px-4 sm:px-6 lg:px-8">
    <div class="space-y-6 max-w-7xl mx-auto pb-6">

        <div>
            <a href="/" class="inline-flex items-center gap-2 text-xs font-semibold text-slate-400 hover:text-white transition">
                <i class="fa-solid fa-arrow-left"></i> Volver al inicio
            </a>
        </div>

        <!-- 1. CABECERA PRINCIPAL Y KPIS EJECUTIVOS -->
        <div class="bg-slate-900/90 p-6 rounded-2xl shadow-xl border border-slate-800 flex flex-col md:flex-row items-center justify-between gap-6 relative overflow-hidden">
            <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>
            
            <div class="flex items-center gap-4 z-10">
                <div class="w-14 h-14 rounded-2xl bg-teal-500/20 text-teal-400 border border-teal-500/30 flex items-center justify-center text-2xl shrink-0 shadow-inner">
                    <i class="fa-solid fa-user-gear"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <h1 class="text-2xl font-bold text-white tracking-tight">Panel de Administración</h1>
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-teal-500/20 text-teal-300 border border-teal-500/40 uppercase tracking-wider">
                            Sistema
                        </span>
                    </div>
                    <p class="text-xs text-slate-400">
                        <% if (locals.user) { %>
                            Bienvenido, <span class="text-slate-200 font-semibold"><%= user.nombre %> <%= user.apellido %></span> (<%= user.rol %>)
                        <% } else { %>
                            Gestión general del sistema
                        <% } %>
                    </p>
                </div>
            </div>

            <!-- Indicadores de métricas del colegio -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 w-full md:w-auto z-10">
                <div class="bg-slate-950/80 p-3 rounded-xl border border-slate-800 text-center min-w-[105px]">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Usuarios</p>
                    <p class="text-xl font-extrabold text-teal-400"><%= locals.totalUsuarios || 0 %></p>
                </div>
                <div class="bg-slate-950/80 p-3 rounded-xl border border-slate-800 text-center min-w-[105px]">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Docentes</p>
                    <p class="text-xl font-extrabold text-sky-400"><%= locals.totalProfesores || 0 %></p>
                </div>
                <div class="bg-slate-950/80 p-3 rounded-xl border border-slate-800 text-center min-w-[105px]">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Estudiantes</p>
                    <p class="text-xl font-extrabold text-indigo-400"><%= locals.totalEstudiantes || 0 %></p>
                </div>
                <div class="bg-slate-950/80 p-3 rounded-xl border border-slate-800 text-center min-w-[105px]">
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Solicitudes</p>
                    <p class="text-xl font-extrabold text-amber-400"><%= locals.totalSolicitudes || 0 %></p>
                </div>
            </div>
        </div>

        <!-- Mensajes de Error o Éxito -->
        <% if (locals.error) { %>
            <div class="bg-red-500/10 border border-red-500/30 text-red-300 px-4 py-3 rounded-xl text-xs flex items-center gap-2">
                <i class="fa-solid fa-circle-exclamation text-red-400"></i>
                <span><%= error %></span>
            </div>
        <% } %>
        <% if (locals.success) { %>
            <div class="bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 px-4 py-3 rounded-xl text-xs flex items-center gap-2">
                <i class="fa-solid fa-circle-check text-emerald-400"></i>
                <span><%= success %></span>
            </div>
        <% } %>

        <!-- 2. GRID DE MÓDULOS DE ADMINISTRACIÓN (6 MÓDULOS) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

            <!-- Módulo 1: Profesores -->
            <div class="bg-slate-900/90 p-6 rounded-2xl shadow-xl border border-slate-800 flex flex-col justify-between space-y-4 hover:border-slate-700 transition">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-11 h-11 rounded-xl bg-sky-500/20 text-sky-400 border border-sky-500/30 flex items-center justify-center text-lg shadow-inner">
                            <i class="fa-solid fa-chalkboard-user"></i>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-sky-500/10 text-sky-300 border border-sky-500/30">
                            <%= locals.totalProfesores || 0 %> activos
                        </span>
                    </div>
                    <h2 class="font-bold text-white text-base mb-1">Profesores</h2>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Gestiona el cuerpo docente, revisa sus asignaturas asignadas y detalles personales.
                    </p>
                </div>

                <a href="/admin/profesores" class="w-full py-2.5 bg-teal-600 hover:bg-teal-500 text-white font-semibold rounded-xl text-xs transition flex items-center justify-center gap-2 shadow-md">
                    <i class="fa-solid fa-users-gear text-xs"></i>
                    <span>Ver Profesores</span>
                </a>
            </div>

            <!-- Módulo 2: Estudiantes -->
            <div class="bg-slate-900/90 p-6 rounded-2xl shadow-xl border border-slate-800 flex flex-col justify-between space-y-4 hover:border-slate-700 transition">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-11 h-11 rounded-xl bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 flex items-center justify-center text-lg shadow-inner">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-indigo-500/10 text-indigo-300 border border-indigo-500/30">
                            <%= locals.totalEstudiantes || 0 %> activos
                        </span>
                    </div>
                    <h2 class="font-bold text-white text-base mb-1">Estudiantes</h2>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Revisa el listado de alumnos, sus cursos, calificaciones y expedientes PIE.
                    </p>
                </div>

                <a href="/admin/students" class="w-full py-2.5 bg-teal-600 hover:bg-teal-500 text-white font-semibold rounded-xl text-xs transition flex items-center justify-center gap-2 shadow-md">
                    <i class="fa-solid fa-address-book text-xs"></i>
                    <span>Ver Estudiantes</span>
                </a>
            </div>

            <!-- Módulo 3: Apoderados -->
            <div class="bg-slate-900/90 p-6 rounded-2xl shadow-xl border border-slate-800 flex flex-col justify-between space-y-4 hover:border-slate-700 transition">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-11 h-11 rounded-xl bg-purple-500/20 text-purple-400 border border-purple-500/30 flex items-center justify-center text-lg shadow-inner">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-purple-500/10 text-purple-300 border border-purple-500/30">
                            <%= locals.totalApoderados || 0 %> activos
                        </span>
                    </div>
                    <h2 class="font-bold text-white text-base mb-1">Apoderados</h2>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Administra la información de contacto de los padres y tutores legales.
                    </p>
                </div>

                <a href="/admin/apoderadoA" class="w-full py-2.5 bg-teal-600 hover:bg-teal-500 text-white font-semibold rounded-xl text-xs transition flex items-center justify-center gap-2 shadow-md">
                    <i class="fa-solid fa-user-group text-xs"></i>
                    <span>Ver Apoderados</span>
                </a>
            </div>

            <!-- Módulo 4: Solicitudes de Registro -->
            <div class="bg-slate-900/90 p-6 rounded-2xl shadow-xl border border-slate-800 flex flex-col justify-between space-y-4 hover:border-slate-700 transition">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-11 h-11 rounded-xl bg-amber-500/20 text-amber-400 border border-amber-500/30 flex items-center justify-center text-lg shadow-inner">
                            <i class="fa-solid fa-id-card"></i>
                        </div>
                        <% const nSol = locals.totalSolicitudes || 0; %>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold <%= nSol > 0 ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40 animate-pulse' : 'bg-slate-800 text-slate-300 border border-slate-700' %>">
                            <%= nSol %> pendientes
                        </span>
                    </div>
                    <h2 class="font-bold text-white text-base mb-1">Solicitudes</h2>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Aprueba o rechaza nuevos registros de usuarios para darles acceso a la plataforma.
                    </p>
                </div>

                <a href="/admin/solicitudes" class="w-full py-2.5 bg-teal-600 hover:bg-teal-500 text-white font-semibold rounded-xl text-xs transition flex items-center justify-center gap-2 shadow-md">
                    <i class="fa-solid fa-user-check text-xs"></i>
                    <span>Revisar Solicitudes</span>
                </a>
            </div>

            <!-- Módulo 5: Cursos y Ramos -->
            <div class="bg-slate-900/90 p-6 rounded-2xl shadow-xl border border-slate-800 flex flex-col justify-between space-y-4 hover:border-slate-700 transition">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-11 h-11 rounded-xl bg-teal-500/20 text-teal-400 border border-teal-500/30 flex items-center justify-center text-lg shadow-inner">
                            <i class="fa-solid fa-school"></i>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-teal-500/10 text-teal-300 border border-teal-500/30">
                            Año Lectivo
                        </span>
                    </div>
                    <h2 class="font-bold text-white text-base mb-1">Cursos & Ramos</h2>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Configura los niveles, secciones, asignaturas y períodos académicos del establecimiento.
                    </p>
                </div>

                <a href="/admin/cursos" class="w-full py-2.5 bg-teal-600 hover:bg-teal-500 text-white font-semibold rounded-xl text-xs transition flex items-center justify-center gap-2 shadow-md">
                    <i class="fa-solid fa-chalkboard text-xs"></i>
                    <span>Gestionar Cursos</span>
                </a>
            </div>

            <!-- Módulo 6: Avisos e Informes -->
            <div class="bg-slate-900/90 p-6 rounded-2xl shadow-xl border border-slate-800 flex flex-col justify-between space-y-4 hover:border-slate-700 transition">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-11 h-11 rounded-xl bg-rose-500/20 text-rose-400 border border-rose-500/30 flex items-center justify-center text-lg shadow-inner">
                            <i class="fa-solid fa-bullhorn"></i>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-500/10 text-rose-300 border border-rose-500/30">
                            Comunicados
                        </span>
                    </div>
                    <h2 class="font-bold text-white text-base mb-1">Avisos y Circulares</h2>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Publica comunicados dirigidos a apoderados, docentes o a toda la comunidad escolar.
                    </p>
                </div>

                <a href="/admin/avisos" class="w-full py-2.5 bg-teal-600 hover:bg-teal-500 text-white font-semibold rounded-xl text-xs transition flex items-center justify-center gap-2 shadow-md">
                    <i class="fa-solid fa-paper-plane text-xs"></i>
                    <span>Publicar Aviso</span>
                </a>
            </div>

        </div>
    </div>
</main>

<%- include('../partials/footer') %>